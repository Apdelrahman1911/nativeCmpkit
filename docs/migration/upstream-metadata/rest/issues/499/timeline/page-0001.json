or scheme can't match their branding on iOS while using these adaptive components.","reactions":{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/471/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/471/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"event":"cross-referenced"}]