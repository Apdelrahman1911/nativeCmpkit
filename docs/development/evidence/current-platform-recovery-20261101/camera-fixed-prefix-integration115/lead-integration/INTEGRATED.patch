+class FirstOnlyResult(unittest.TextTestResult):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs); self.rows = {}; self.order = []; self.subtests = []
+    def startTest(self, test):
+        super().startTest(test); key = test._testMethodName; self.order.append(key)
+        self.rows[key] = {"method": key, "started_monotonic": time.monotonic(), "failures": 0, "errors": 0, "skips": 0}
+    def addFailure(self, test, err):
+        self.rows[test._testMethodName]["failures"] += 1; super().addFailure(test, err)
+    def addError(self, test, err):
+        self.rows[test._testMethodName]["errors"] += 1; super().addError(test, err)
+    def addSkip(self, test, reason):
+        self.rows[test._testMethodName]["skips"] += 1; super().addSkip(test, reason)
+    def addSubTest(self, test, subtest, err):
+        if err is not None:
+            key = "failures" if issubclass(err[0], test.failureException) else "errors"
+            self.rows[test._testMethodName][key] += 1
+        self.subtests.append({"method": test._testMethodName, "status": "passed" if err is None else "failed",
+                              "case": dict(subtest.params), "exception_class": None if err is None else err[0].__name__})
+        super().addSubTest(test, subtest, err)
+    def stopTest(self, test):
+        row = self.rows[test._testMethodName]
+        row["duration_seconds"] = time.monotonic() - row.pop("started_monotonic")
+        row["status"] = "failed" if row["failures"] or row["errors"] else "skipped" if row["skips"] else "passed"
+        super().stopTest(test)
