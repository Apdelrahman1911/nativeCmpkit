<?xml version="1.0" encoding="utf-8"?>
<!-- These synthetic providers/components exist only in the disposable test APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="io.github.apdelrahman1911.nativecmpkit.verification.sharerecipient.BIND_RECIPIENT" />
    <uses-permission android:name="io.github.apdelrahman1911.nativecmpkit.verification.sharedocuments.SELECT_DOCUMENTS" />
    <queries>
        <package android:name="io.github.apdelrahman1911.nativecmpkit.verification.sharerecipient" />
        <package android:name="io.github.apdelrahman1911.nativecmpkit.verification.sharedocuments" />
    </queries>
    <application>
        <activity android:name="com.mohamedrejeb.calf.share.ShareVerificationActivity"
            android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share-device-files"
            android:exported="false" android:grantUriPermissions="true"
            android:process=":nativecmpkit_share_device_provider">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/nativecmpkit_share_device_paths" />
        </provider>
        <provider android:name="com.mohamedrejeb.calf.share.GrantlessShareProvider"
            android:authorities="${applicationId}.share-device-grantless"
            android:exported="false" android:grantUriPermissions="false"
            android:process=":nativecmpkit_share_device_provider" />
    </application>
</manifest>
