4","html_url":"https://github.com/ganluo960214","followers_url":"https://api.github.com/users/ganluo960214/followers","following_url":"https://api.github.com/users/ganluo960214/following{/other_user}","gists_url":"https://api.github.com/users/ganluo960214/gists{/gist_id}","starred_url":"https://api.github.com/users/ganluo960214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ganluo960214/subscriptions","organizations_url":"https://api.github.com/users/ganluo960214/orgs","repos_url":"https://api.github.com/users/ganluo960214/repos","events_url":"https://api.github.com/users/ganluo960214/events{/privacy}","received_events_url":"https://api.github.com/users/ganluo960214/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-09-18T16:34:14Z","updated_at":"2024-09-18T16:34:14Z","body":"```kotlin\r\n\r\n@Composable\r\nfun App() {\r\n  demoC()\r\n}\r\n\r\n/**\r\n * (Boolean)->Unit\r\n */\r\n@OptIn(ExperimentalPermissionsApi::class)\r\n@Composable\r\nfun demoA(){\r\n  Scaffold {\r\n\r\n    val scope = rememberCoroutineScope()\r\n\r\n    val onPermissionResult:(\r\n      result:Boolean,\r\n      permissionState:PermissionState,\r\n      success: ()->Unit\r\n    )->Unit = { result, permissionState, success ->\r\n      if (result) {\r\n        success()\r\n      } else {\r\n        if (permissionState.status.shouldShowRationale){\r\n          permissionState.openAppSettings()\r\n        }\r\n      }\r\n    }\r\n\r\n    val context = LocalPlatformContext.current\r\n    val imagePickerLauncher = rememberFilePickerLauncher(\r\n      type = FilePickerFileType.Image,\r\n      selectionMode = FilePickerSelectionMode.Multiple,\r\n      onResult = { files ->\r\n        scope.launch {\r\n          files.firstOrNull()?.readByteArray(context)\r\n        }\r\n      }\r\n    )\r\n\r\n\r\n    lateinit var galleryImagePermission: PermissionState\r\n    galleryImagePermission = rememberPermissionState(\r\n      permission = Permission.Gallery,\r\n    ) {\r\n      onPermissionResult(it, galleryImagePermission) {\r\n        imagePickerLauncher.launch()\r\n      }\r\n    }\r\n\r\n    Column(modifier = Modifier.padding(it)) {\r\n\r\n      Text(\"galleryImagePermission:\"+galleryImagePermission.status.toString())\r\n\r\n      Button(\r\n        onClick = {\r\n          galleryImagePermission.launchPermissionRequest()\r\n        },\r\n        content = { Text(\"Button\") }\r\n      )\r\n\r\n    }\r\n\r\n  }\r\n}\r\n\r\n\r\n/**\r\n * (PermissionState)->Unit\r\n */\r\n@OptIn(ExperimentalPermissionsApi::class)\r\n@Composable\r\nfun demoB(){\r\n  Scaffold {\r\n\r\n    val scope = rememberCoroutineScope()\r\n\r\n    val onPermissionResult:(\r\n      permissionState:PermissionState,\r\n      success: ()->Unit\r\n    )->Unit = { permissionState, success ->\r\n      if (permissionState.status.isGranted) {\r\n        success()\r\n      } else {\r\n        if (permissionState.status.shouldShowRationale){\r\n          permissionState.openAppSettings()\r\n        }\r\n      }\r\n    }\r\n\r\n    val context = LocalPlatformContext.current\r\n    val imagePickerLauncher = rememberFilePickerLauncher(\r\n      type = FilePickerFileType.Image,\r\n      selectionMode = FilePickerSelectionMode.Multiple,\r\n      onResult = { files ->\r\n        scope.launch {\r\n          files.firstOrNull()?.readByteArray(context)\r\n        }\r\n      }\r\n    )\r\n\r\n    val galleryImagePermission = rememberPermissionState(\r\n      permission = Permission.Gallery,\r\n    ) {\r\n//      val it = PermissionState() // <-------- hero\r\n//      onPermissionResult(it) {\r\n//        imagePickerLauncher.launch()\r\n//      }\r\n    }\r\n\r\n    Column(modifier = Modifier.padding(it)) {\r\n\r\n      Text(\"galleryImagePermission:\"+galleryImagePermission.status.toString())\r\n\r\n      Button(\r\n        onClick = {\r\n          galleryImagePermission.launchPermissionRequest()\r\n        },\r\n        content = { Text(\"Button\") }\r\n      )\r\n    }\r\n\r\n  }\r\n}\r\n\r\n\r\n/**\r\n * use LaunchedEffect\r\n */\r\n@OptIn(ExperimentalPermissionsApi::class)\r\n@Composable\r\nfun demoC(){\r\n  Scaffold {\r\n\r\n    val scope = rememberCoroutineScope()\r\n\r\n    val context = LocalPlatformContext.current\r\n    val imagePickerLauncher = rememberFilePickerLauncher(\r\n      type = FilePickerFileType.Image,\r\n      selectionMode = FilePickerSelectionMode.Multiple,\r\n      onResult = { files ->\r\n        scope.launch {\r\n          files.firstOrNull()?.readByteArray(context)\r\n        }\r\n      }\r\n    )\r\n\r\n    val galleryImagePermission = rememberPermissionState(\r\n      permission = Permission.Gallery,\r\n    )\r\n\r\n\r\n    LaunchedEffect(galleryImagePermission.status){\r\n      // the code will execute by init and the FilePicker will be launch\r\n      if (galleryImagePermission.status.isGranted) {\r\n        imagePickerLauncher.launch()\r\n      }\r\n    }\r\n\r\n\r\n\r\n    Column(modifier = Modifier.padding(it)) {\r\n\r\n      Text(\"galleryImagePermission:\"+galleryImagePermission.status.toString())\r\n\r\n      Button(\r\n        onClick = {\r\n          galleryImagePermission.launchPermissionRequest()\r\n        },\r\n        content = { Text(\"Button\") }\r\n      )\r\n    }\r\n\r\n  }\r\n}\r\n\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/2358930752/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"ganluo960214","id":8499204,"node_id":"MDQ6VXNlcjg0OTkyMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/8499204?v=4","gravatar_id":"","url":"https://api.github.com/users/ganluo960214","html_url":"https://github.com/ganluo960214","followers_url":"https://api.github.com/users/ganluo960214/followers","following_url":"https://api.github.com/users/ganluo960214/