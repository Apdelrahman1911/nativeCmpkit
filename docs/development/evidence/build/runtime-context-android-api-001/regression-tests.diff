+            ("git", "rev-parse", "HEAD"): "a" * 40 + "\n",
+            ("git", "status", "--porcelain", "--untracked-files=normal"): "",
+            ("java", "-version"): 'openjdk version "17.0.20"\n',
+            ("rustc", "--version", "--verbose"):
+                "release: 1.98.0\nhost: x86_64-unknown-linux-gnu\ncommit-hash: "
+                + "b" * 40 + "\ncommit-date: 2026-08-18\n",
+        }
+        with (mock.patch.object(r, "ROOT", root),
+              mock.patch.object(r, "command", side_effect=lambda *args: responses[args]) as commands,
+              mock.patch.dict(r.os.environ, environment, clear=True),
+              mock.patch.object(r.platform, "machine", return_value="x86_64"),
+              mock.patch.object(r.platform, "system", return_value="Linux"),
+              mock.patch.object(r.platform, "python_version", return_value="3.12.3")):
+            yield commands
