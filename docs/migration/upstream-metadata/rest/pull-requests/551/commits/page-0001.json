3068a","url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/be274cc530ff92e6e3bde9ac0ffbb912d5e3068a","html_url":"https://github.com/MohamedRejeb/Calf/commit/be274cc530ff92e6e3bde9ac0ffbb912d5e3068a"}]},{"sha":"b82e19d9639d617b2a1d44df9ba22f6314fc7ad7","node_id":"C_kwDOKDql7toAKGI4MmUxOWQ5NjM5ZDYxN2IyYTFkNDRkZjliYTIyZjYzMTRmYzdhZDc","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:54:24Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:54:24Z"},"message":"fix(io): KmpFile.getPath on iOS is the path of the readable copy\n\nThe original picked location is security scoped, so a path to it could not be\nopened after the picker callback. getPath now returns the path of KmpFile.url,\nthe app's copy, which keeps the picked file's name. getName and toUriString\nstill describe the original.","tree":{"sha":"604b494463e05aabc88768e9a24741f25dd0e2a5","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/604b494463e05aabc88768e9a24741f25dd0e2a5"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/b82e19d9639d617b2a1d44df9ba22f6314fc7ad7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/b82e19d9639d617b2a1d44df9ba22f6314fc7ad7","html_url":"https://github.com/MohamedRejeb/Calf/commit/b82e19d9639d617b2a1d44df9ba22f6314fc7ad7","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/b82e19d9639d617b2a1d44df9ba22f6314fc7ad7/comments","author":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/Moha