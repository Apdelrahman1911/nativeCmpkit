[{"sha":"2a59f08f794e613d21c89f52a236bb5628ab3bcd","node_id":"C_kwDOKDql7toAKDJhNTlmMDhmNzk0ZTYxM2QyMWM4OWY1MmEyMzZiYjU2MjhhYjNiY2Q","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/2a59f08f794e613d21c89f52a236bb5628ab3bcd","html_url":"https://github.com/MohamedRejeb/Calf/commit/2a59f08f794e613d21c89f52a236bb5628ab3bcd","author":{"name":"Szymon Parafiński","email":"sparafinski@fandom.com","date":"2026-11-05T10:11:47Z"},"committer":{"name":"Szymon Parafiński","email":"sparafinski@fandom.com","date":"2026-11-05T10:11:47Z"},"tree":{"sha":"b66d95dec9b4414491f5414d6a58cf587fcdcf1c","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/b66d95dec9b4414491f5414d6a58cf587fcdcf1c"},"message":"Add Painter images and native appearance styling to AdaptiveNavigationBar on iOS\n\nUIKitImage.Painter draws any Compose Painter (painterResource,\nrememberVectorPainter, image loaders) offscreen at the screen density, so\neven-odd fills, strokes, transforms and bitmaps survive, and lets the caller\npick the UIKit rendering mode (template vs original). UIKitImage.Bitmap gains\nscale and rendering mode. ImageBitmap -> UIImage now goes through PNG\nencoding, which keeps premultiplied alpha and channel order correct for\ncolored content.\n\nUIKitTabBarConfiguration gains per-state icon/title colors, a title font\n(UIKitFont.System / UIKitFont.Named) and a background color, applied through\nUITabBarAppearance. TabBarManager updates native items in place when only\ntheir content changed, so an asynchronously loaded image does not rebuild\nthe tab bar.","parents":[{"sha":"af388bd3ad0325b2afdd8c0149cb7ff6f24c5da6","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/af388bd3ad0325b2afdd8c0149cb7ff6f24c5da6","html_url":"https://github.com/MohamedRejeb/Calf/commit/af388bd3ad0325b2afdd8c0149cb7ff6f24c5da6"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d7f022d8c56afd3e