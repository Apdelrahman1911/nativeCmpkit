+"""Owning finite-storage source models only; no SDK, Gradle, emulator or native runs."""
+import ast
+import copy
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+import unittest
+from unittest.mock import patch
+
+import android_device_batch as batch
+import android_device_batch_plan as fixed
+import android_device_tests as device
+import android_storage_compatibility_plan as storage
+import library_tests as lt
+import workflow_matrix as workflow
+
+ROOT = lt.ROOT
+PROFILE = "android-storage-compatibility"
+MODULE = "calf-permissions/core"
+CLASS = "com.mohamedrejeb.calf.permissions.AndroidStorageCompatibilityTest"
+EXPECTED = (
+    ("android-storage-api28", 28, "legacy28", 28, "api28LegacyPermissionControlsSharedStorage"),
+    ("android-storage-api29-target28", 29, "legacyTarget28", 28,
+     "api29Target28LegacyAccessStillNeedsNativeWriteDespiteNotRequiredHelper"),
+    ("android-storage-api29-legacy", 29, "legacy29", 29,
+     "api29Target29LegacyAccessStillNeedsNativeWriteDespiteNotRequiredHelper"),
+    ("android-storage-api29-scoped", 29, "scoped29", 29,
+     "api29ScopedAccessStaysBoundedWithNativeWriteGrant"),
+    ("android-storage-api30-normal", 30, "modern", 35, "modernAppScopedAndSafDoNotNeedAllFiles"),
+    ("android-storage-api30-all-files", 30, "allFiles", 35,
+     "modernManifestAloneDoesNotGrantAllFilesAndOwnedSettingRestores"),
+)
+ORIGINAL_BATCHES = {
+    "android-io-permission-storage-api35": (
+        "android-io-reference-regressions", "android-permission-demo",
+        "android-storage-api35-normal", "android-storage-api35-all-files",
+    ),
+    "android-permission-storage-compatibility": (
+        "android-media-selection-api33", "android-media-selection-api34",
+        "android-storage-api28", "android-storage-api29-target28",
+        "android-storage-api29-legacy", "android-storage-api29-scoped",
+        "android-storage-api30-normal", "android-storage-api30-all-files",
+    ),
+}
+
+
+class AndroidStorageCompatibilityFiniteProfileTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        # These are source plans, not instrumented executions or accepted-suite
+        # replays. The API35 pair is retained in its original fixed batch.
+        cls.selection = batch.plan(ROOT, PROFILE)
+        cls.api35_sources = [lt.plan(ROOT, "android-device", only_modules=(MODULE,), focus=name)
+            for name in ("android-storage-api35-normal", "android-storage-api35-all-files")]
+
+    def test_new_batch_keeps_exact_six_original_api_flavor_target_method_contracts(self):
+        self.assertEqual(tuple(row[0] for row in EXPECTED), fixed.BATCHES[PROFILE])
+        self.assertEqual(6, self.selection["requested_target_executions"])
+        self.assertEqual(6, self.selection["requested_distinct_methods"])
+        self.assertEqual(6, len(self.selection["routes"]))
+        for route, (profile, api, flavor, target, method) in zip(self.selection["routes"], EXPECTED):
+            with self.subTest(profile=profile):
+                self.assertEqual((profile, api, MODULE, profile),
+                    (route["profile"], route["api_level"], route["module"], route["focus"]))
+                self.assertEqual((api, MODULE, profile), fixed.SELECTIONS[profile])
+                original, = workflow.matrix(profile)["include"]
+                self.assertEqual((str(api), flavor, str(target)),
+                    (original["emulator-api"], original["storage-flavor"], original["storage-target-sdk"]))
+                source = route["source_suite"]
+                self.assertTrue(lt.validate_test_focus(source))
+                self.assertIs(source["complete_suite_requested"], False)
+                self.assertEqual([MODULE], source["explicit_module_subset"])
+                item, = source["expected"]
+                self.assertEqual(MODULE, item["module"])
+                self.assertEqual(":calf-permissions:calf-permissions-core:connectedAndroidDeviceTest", item["task"])
+                self.assertEqual(MODULE + "/build/outputs/androidTest-results/connected/androidMain", item["report_directory"])
+                self.assertEqual(CLASS + "#" + method, item["test_filter"])
+                self.assertEqual([{"classname": CLASS, "name": method}], item["required_testcases"])
+                helper = source["android_storage_probe"]
+                self.assertEqual((profile, api, flavor, target),
+                    (helper["profile"], helper["verification_api_level"], helper["flavor"], helper["target_sdk"]))
+                self.assertEqual("tests/consumer/android-storage-probe", helper["source_fixture"])
+                self.assertEqual(storage.PACKAGE, helper["package"])
+                self.assertIs(helper["source_contract"]["native_or_compile_success_inferred"], False)
+
+    def test_storage_completion_count_is_source_derived_eight_executions_six_methods(self):
+        sources = [route["source_suite"] for route in self.selection["routes"]] + self.api35_sources
+        identities = [tuple(case[key] for key in ("classname", "name")) for source in sources
+                      for case in source["expected"][0]["required_testcases"]]
+        self.assertEqual(8, len(identities))
+        self.assertEqual(6, len(set(identities)))
+        self.assertEqual([35, 35], [source["android_storage_probe"]["verification_api_level"]
+            for source in self.api35_sources])
+        self.assertEqual(list(ORIGINAL_BATCHES["android-io-permission-storage-api35"][-2:]),
+            [source["explicit_test_focus"] for source in self.api35_sources])
+        self.assertEqual([28, 29, 29, 29, 30, 30], [route["api_level"] for route in self.selection["routes"]])
+        self.assertFalse(any("media" in route["profile"] for route in self.selection["routes"]))
+        self.assertIs(self.selection["source_only"], True)
+        self.assertIs(self.selection["same_workspace_serial_only"], True)
+        self.assertEqual(0, self.selection["native_tests_executed"])
+        self.assertEqual(0, self.selection["Gradle_builds_executed"])
+        self.assertIs(self.selection["compilation_or_native_acceptance_inferred"], False)
+
+    def test_one_existing_host_and_both_original_batches_all_eleven_full_slots_survive(self):
+        for name, routes in ORIGINAL_BATCHES.items():
+            self.assertEqual(routes, fixed.BATCHES[name])
+            self.assertIn(name, workflow.PROFILES)
+        self.assertEqual("calf-io,calf-permissions/core", fixed.MODULES["android-io-permission-storage-api35"])
+        self.assertEqual(MODULE, fixed.MODULES["android-permission-storage-compatibility"])
+        self.assertEqual(MODULE, fixed.MODULES[PROFILE])
+        row, = workflow.matrix(PROFILE)["include"]
+        self.assertEqual({"slot": "android-device-batch-storage-compatibility", "suite": "android-device",
+            "runner": "ubuntu-24.04", "arch": "x64", "python": "python3",
+            "test-modules": MODULE, "android-batch": PROFILE}, row)
+        self.assertEqual(("android-device-api35",), workflow.PROFILES[PROFILE])
+        self.assertEqual([
+            "desktop-linux-x64", "android-host", "browser-js", "browser-wasm", "desktop-macos-arm64",
+            "ios-iphone", "desktop-windows-x64", "desktop-linux-arm64", "desktop-macos-x64",
+            "ios-ipad", "android-device-api35"], [row["slot"] for row in workflow.matrix("all")["include"]])
+        self.assertEqual(11, len(workflow.SLOTS))
+
+    def test_dispatch_membership_and_explicit_sdk_branch_match_only_api28_api29_api30(self):
+        text = (ROOT / ".github/workflows/gradle.yml").read_text(encoding="utf-8")
+        options, = re.findall(r"(?m)^        options: \[([^\]\n]+)\]$", text)
+        choices = [option.strip() for option in options.split(",")]
+        self.assertTrue(all(re.fullmatch(r"[a-z][a-z0-9-]*", choice) for choice in choices))
+        self.assertEqual(len(choices), len(set(choices)))
+        self.assertEqual(1, choices.count(PROFILE))
+        self.assertTrue(set(ORIGINAL_BATCHES) <= set(choices))
+        self.assertTrue(set(route[0] for route in EXPECTED) <= set(choices))
