[{"sha":"ee359cef3c5a2792059775ca12f2f8f6a88ee688","node_id":"C_kwDOKDql7toAKGVlMzU5Y2VmM2M1YTI3OTIwNTk3NzVjYTEyZjJmOGY2YTg4ZWU2ODg","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-03-16T16:48:13Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-03-16T16:48:13Z"},"message":"Add cross-platform `CookieManager` to `WebView`\n\nIntroduces a `CookieManager` API to manage HTTP cookies across Android, iOS, and Desktop platforms.\n\n- Added `Cookie` data class to represent cookie properties.\n- Added `CookieManager` expect class with `setCookie`, `getCookies`, and `removeAllCookies` methods.\n- Implemented `CookieManager` for Android using `android.webkit.CookieManager`.\n- Implemented `CookieManager` for iOS using `WKHTTPCookieStore`.\n- Implemented `CookieManager` for Desktop using `java.net.CookieManager`.\n- Added no-op `CookieManager` implementations for JS and WasmJS.\n- Exposed `cookieManager` through the `WebView` interface and its platform-specific implementations.\n- Updated the sample `WebViewScreen` to demonstrate cookie management.","tree":{"sha":"27d577790777a5b99e3f4cf1b364ebcad49c5ef6","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/27d577790777a5b99e3f4cf1b364ebcad49c5ef6"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/ee359cef3c5a2792059775ca12f2f8f6a88ee688","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/ee359cef3c5a2792059775ca12f2f8f6a88ee688","html_url":"https://github.com/MohamedRejeb/Calf/commit/ee359cef3c5a2792059775ca12f2f8f6a88ee688","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/ee359cef3c5a2792059775ca12f2f8f6a88ee688/comments","author":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4