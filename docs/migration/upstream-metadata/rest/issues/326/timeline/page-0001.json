[{"sha":"7898be39165470912ecfff77d9951d56b1201c51","node_id":"C_kwDOKDql7toAKDc4OThiZTM5MTY1NDcwOTEyZWNmZmY3N2Q5OTUxZDU2YjEyMDFjNTE","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/7898be39165470912ecfff77d9951d56b1201c51","html_url":"https://github.com/MohamedRejeb/Calf/commit/7898be39165470912ecfff77d9951d56b1201c51","author":{"name":"Michelle Raouf","email":"michelle.raouf@52ndsolution.net","date":"2025-06-29T09:33:38Z"},"committer":{"name":"Michelle Raouf","email":"michelle.raouf@52ndsolution.net","date":"2025-06-29T09:33:38Z"},"tree":{"sha":"27f0228db2396a6f953202d001d2965d6ef30f54","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/27f0228db2396a6f953202d001d2965d6ef30f54"},"message":"Fix camera image URL retrieval on iOS and bump dependencies\n\nThis commit addresses an issue on iOS where the camera picker was\nattempting to retrieve the image URL using `UIImagePickerControllerMediaURL`,\nwhich is intended for videos. This has been corrected to retrieve the\noriginal image using `UIImagePickerControllerOriginalImage`, save it to a\ntemporary file, and then provide the URL of this temporary file.\n\nThis change also ensures the picker delegate is strongly referenced to\nprevent premature deallocation and presents the picker controller on the\nmain thread. Additionally, it falls back to the photo library if the\ncamera is not available (e.g., on a simulator).\n\nThe sample app has been updated to display the retrieved image path.\n\nThe following dependencies have also been updated:\n- Android Gradle Plugin (AGP) from 8.7.3 to 8.10.1\n- Kotlin from 2.1.21 to 2.2.0\n- Compose from 1.8.1 to 1.8.2\n- Android compile SDK from 35 to 36\n- Compose Navigation from 2.9.0-beta02 to 2.9.0-beta03","parents":[{"sha":"fd480509a272ebc183208f8d965356bec296fb1c","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/fd480509a272ebc183208f8d965356bec296fb1c","html_url":"https://github.com/MohamedRejeb/Calf/commit/fd480509a272ebc183208f8d965356bec296fb1c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/3016489749","html_url":"https://github.com/MohamedRejeb/Calf/pull/326#issuecomment-3016489749","issue_url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/326","id":3016489749,"node_id":"IC_kwDOKDql7s6zy_sV","user":{"login":"the-best-is-best","id":72160249,"node_id":"MDQ6VXNlcjcyMTYwMjQ5","avatar_url":"https://avatars.githubusercontent.com/u/72160249?v=4","gravatar_id":"","url":"https://api.github.com/users/the-best-is-best","html_url":"https://github.com/the-best-is-best","followers_url":"https://api.github.com/users/the-best-is-best/followers","following_url":"https://api.github.com/users/the-best-is-best/following{/other_user}","gists_url":"https://api.github.com/users/the-best-is-best/gists{/gist_id}","starred_url":"https://api.github.com/users/the-best-is-best/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/the-best-is-best/subscriptions","organizations_url":"https://api.github.com/users/the-best-is-best/orgs","repos_url":"https://api.github.com/users/the-best-is-best/repos","events_url":"https://api.github.com/users/the-best-is-best/events{/privacy}","received_events_url":"https://api.github.com/users/the-best-is-best/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-29T09:43:20Z","updated_at":"2025-06-29T09:43:20Z","body":"Test it in real device \r\n@MohamedRejeb ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/3016489749/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"the-best-is-best","id":72160249,"node_id":"MDQ6VXNlcjcyMTYwMjQ5","avatar_url":"https: