<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="io.github.apdelrahman1911.nativecmpkit.verification.camerareceiver.BIND_RECEIVER"
        android:protectionLevel="signature" />
    <queries><package android:name="com.mohamedrejeb.calf.calfcamerapicker.test" /></queries>
    <application android:allowBackup="false" android:label="NativeCmpKit owned camera URI receiver">
        <activity android:name=".CameraReceiverActivity" android:exported="true"
            android:permission="io.github.apdelrahman1911.nativecmpkit.verification.camerareceiver.BIND_RECEIVER"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name=".CameraDelayedReceiverActivity" android:exported="true" android:enabled="false"
            android:configChanges="orientation|screenSize" android:resizeableActivity="true"
            android:permission="io.github.apdelrahman1911.nativecmpkit.verification.camerareceiver.BIND_RECEIVER"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter><action android:name="android.media.action.IMAGE_CAPTURE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
        <service android:name=".CameraReceiverService" android:exported="true"
            android:permission="io.github.apdelrahman1911.nativecmpkit.verification.camerareceiver.BIND_RECEIVER" />
    </application>
</manifest>
