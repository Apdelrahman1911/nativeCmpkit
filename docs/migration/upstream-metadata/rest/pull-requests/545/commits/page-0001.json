[{"sha":"c5b8c59c910e71e5227c704c38ff63968263f8b6","node_id":"C_kwDOKDql7toAKGM1YjhjNTljOTEwZTcxZTUyMjdjNzA0YzM4ZmY2Mzk2ODI2M2Y4YjY","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-09-11T06:02:04Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-09-11T08:00:49Z"},"message":"feat(io): add KmpFile.source() for streaming reads with kotlinx-io\n\nCloses #537.\n\nLarge picked files could only be read with readByteArray(), which loads\nthem fully into memory; on Android getPath() returns a content URI, so\nthere was no way to stream them at all.\n\n- calf-io now depends on kotlinx-io (api) and exposes\n  `suspend fun KmpFile.source(context): kotlinx.io.RawSource` plus a\n  context-free overload next to the other KmpFile extensions\n- Android opens the content URI through ContentResolver, iOS and\n  desktop go through SystemFileSystem, JS/Wasm buffer the file in\n  memory because browsers have no synchronous reads\n- kotlinx-io 0.9.1 added to the version catalog\n- Docs: \"Streaming with kotlinx-io\" section in docs/filepicker.md,\n  including the okio bridge via kotlinx-io-okio\n- Sample: file picker screen streams each picked file in 64 KB chunks\n- Tests: KmpFileSourceTest (calf-io desktopTest, 6 tests)","tree":{"sha":"675c154d3d6cc8ac66a93417a6420b4e2cc0a919","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/675c154d3d6cc8ac66a93417a6420b4e2cc0a919"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/c5b8c59c910e71e5227c704c38ff63968263f8b6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/c5b8c59c910e71e5227c704c38ff63968263f8b6","html_url":"https://github.com/MohamedRejeb/Calf/commit/c5b8c59c910e71e5227c704c38ff63968263f8b6","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/c5b8c59c910e71e5227c704c38ff639