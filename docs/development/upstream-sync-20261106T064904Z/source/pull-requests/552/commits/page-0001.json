[{"sha":"2a59f08f794e613d21c89f52a236bb5628ab3bcd","node_id":"C_kwDOVj5DBtoAKDJhNTlmMDhmNzk0ZTYxM2QyMWM4OWY1MmEyMzZiYjU2MjhhYjNiY2Q","commit":{"author":{"name":"Szymon Parafiński","email":"sparafinski@fandom.com","date":"2026-11-05T10:11:47Z"},"committer":{"name":"Szymon Parafiński","email":"sparafinski@fandom.com","date":"2026-11-05T10:11:47Z"},"message":"Add Painter images and native appearance styling to AdaptiveNavigationBar on iOS\n\nUIKitImage.Painter draws any Compose Painter (painterResource,\nrememberVectorPainter, image loaders) offscreen at the screen density, so\neven-odd fills, strokes, transforms and bitmaps survive, and lets the caller\npick the UIKit rendering mode (template vs original). UIKitImage.Bitmap gains\nscale and rendering mode. ImageBitmap -> UIImage now goes through PNG\nencoding, which keeps premultiplied alpha and channel order correct for\ncolored content.\n\nUIKitTabBarConfiguration gains per-state icon/title colors, a title font\n(UIKitFont.System / UIKitFont.Named) and a background color, applied through\nUITabBarAppearance. TabBarManager updates native items in place when only\ntheir content changed, so an asynchronously loaded image does not rebuild\nthe tab bar.","tree":{"sha":"b66d95dec9b4414491f5414d6a58cf587fcdcf1c","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/b66d95dec9b4414491f5414d6a58cf587fcdcf1c"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/2a59f08f794e613d21c89f52a236bb5628ab3bcd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/2a59f08f794e613d21c89f52a236bb5628ab3bcd","html_url":"https://github.com/MohamedRejeb/Calf/commit/2a59f08f794e613d21c89f52a236bb5628ab3bcd","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/2a59f08f794e613d21c89f52a236bb5628ab3bcd/comments","author":{"login":"sparafinski","id":40520109,"node_id":"MD