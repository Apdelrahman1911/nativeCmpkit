    "body": "val sheetState = rememberAdaptiveSheetState(\n            confirmValueChange = {\n                it != SheetValue.Hidden\n            },\n            skipPartiallyExpanded = true\n        )\n\nAdaptiveBottomSheet(\n            onDismissRequest = {\n                scope.launch {\n                    sheetState.hide()\n                }\n            },\n            adaptiveSheetState = sheetState\n        ) {\n}",
