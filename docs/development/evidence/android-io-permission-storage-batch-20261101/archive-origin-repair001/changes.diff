+        release = {28: "9", 29: "10", 30: "11", 33: "13", 34: "14", 35: "15"}[route["api_level"]]
+        boot = {"api_level": str(route["api_level"]), "serial": plan["serial"],
+            "boot_completed": "1", "selinux": "Enforcing", "release": release}
