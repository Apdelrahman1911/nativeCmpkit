        "postimage": "  ordinary-windows-consumer1:\n    if: github.repository == 'Apdelrahman1911/nativeCmpkit' && contains(fromJSON('[\"refs/heads/development/preview-hardening\",\"refs/heads/development/javafx-ordinary-consumer1\"]'), github.ref) && github.event_name == 'workflow_dispatch' && inputs.platform == 'windows-ordinary-consumer1'\n    runs-on: windows-2025\n    timeout-minutes: 120\n    defaults:\n      run:\n        shell: bash\n    env:\n      GIT_CONFIG_COUNT: '2'\n      GIT_CONFIG_KEY_0: core.autocrlf\n      GIT_CONFIG_VALUE_0: 'false'\n      GIT_CONFIG_KEY_1: core.longpaths\n      GIT_CONFIG_VALUE_1: 'true'\n      CARGO_BUILD_JOBS: '1'\n      NATIVECMPKIT_ORDINARY_PLATFORM: ${{ inputs.platform }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          persist-credentials: false\n      # Action references are allowed; no mandatory SHA pinning policy.\n      - uses: actions/setup-java@v4\n        with:\n          distribution: temurin\n          java-version: '17'\n          overwrite-settings: false\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.12'\n      - uses: gradle/actions/wrapper-validation@v4\n        with:\n          min-wrapper-count: 1\n          allow-snapshots: false\n      - name: Exact existing Rust compiler, no bootstrap or dependency refresh\n        run: |\n          command -v rustup\n          rustup toolchain install 1.98.0 --profile minimal --no-self-update --component rustfmt --component clippy\n      - uses: android-actions/setup-android@v3\n        with:\n          packages: 'cmdline-tools;23.0 platforms;android-37.0'\n          accept-android-sdk-licenses: true\n          log-accepted-android-sdk-licenses: false\n      - name: Qualify SDK23 and current generated source index, not old native tests\n        run: |\n          set -euo pipefail\n          python -B - <<'PY'\n          import os\n          from pathlib import Path\n          manager = Path(os.environ['ANDROID