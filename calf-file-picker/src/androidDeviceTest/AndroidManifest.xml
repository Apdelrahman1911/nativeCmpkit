<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- These components and synthetic cache contents exist only in the test APK. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.picker-device-files"
            android:exported="false"
            android:grantUriPermissions="true"
            android:process=":nativecmpkit_picker_device_provider">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nativecmpkit_picker_device_paths" />
        </provider>
        <provider
            android:name="com.mohamedrejeb.calf.picker.instrumentation.DeviceSaveDocumentsProvider"
            android:authorities="${applicationId}.picker-device-documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":nativecmpkit_picker_device_provider">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <activity
            android:name="com.mohamedrejeb.calf.picker.instrumentation.SaverHostActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="com.mohamedrejeb.calf.picker.instrumentation.SaveDestinationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
