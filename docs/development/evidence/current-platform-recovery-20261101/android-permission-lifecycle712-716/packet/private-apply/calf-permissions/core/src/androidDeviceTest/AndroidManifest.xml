<?xml version="1.0" encoding="utf-8"?>
<!-- Library reporter UID owns only private synthetic SAF input; no runtime storage grants. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The reporter never requests the consumer's runtime permissions itself. -->
    <uses-permission android:name="io.github.apdelrahman1911.nativecmpkit.verification.permissiondemo.BIND_DEMO" />
    <uses-permission android:name="io.github.apdelrahman1911.nativecmpkit.verification.permissionlifecycle.CONTROL_LIFECYCLE" />
    <uses-permission android:name="io.github.apdelrahman1911.nativecmpkit.verification.storageprobe.CONTROL_STORAGE" />
    <queries>
        <package android:name="io.github.apdelrahman1911.nativecmpkit.verification.permissionlifecycle" />
        <package android:name="com.android.settings" />
        <package android:name="io.github.apdelrahman1911.nativecmpkit.verification.permissiondemo" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.google.android.permissioncontroller" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.providers.media.module" />
        <package android:name="com.google.android.providers.media.module" />
        <package android:name="io.github.apdelrahman1911.nativecmpkit.verification.storageprobe" />
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="application/octet-stream" />
        </intent>
    </queries>
    <application>
        <provider android:name="com.mohamedrejeb.calf.permissions.StorageTestDocumentsProvider"
            android:authorities="${applicationId}.storage-documents" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>
