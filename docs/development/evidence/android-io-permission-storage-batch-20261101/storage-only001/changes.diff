+    def test_new_profile_inherits_serial_owned_archive_cleanup_and_resource_budget_paths(self):
+        self.assertEqual(8192, batch.RESERVE_MIB)
+        self.assertEqual(8192, device.RESERVE_MIB)
+        self.assertEqual(5588, device.PORT)
+        self.assertEqual("emulator-5588", device.SERIAL)
+        for route in self.selection["routes"]:
+            relative = "build/ci-verification/finite-storage-model/routes/" + route["profile"]
+            self.assertEqual([sys.executable, "-B", str(ROOT / "scripts/ci/android_device_tests.py"), "run",
+                "--api-level", str(route["api_level"]), "--module", MODULE, "--focus", route["profile"],
+                "--output", relative], batch.command(ROOT, relative, route))
+        # Inspect the shared adapter rather than launch/imitate cleanup. The new
+        # profile adds no parallel executor, alternate signer/AVD or archive path.
+        tree = ast.parse(Path(batch.__file__).read_text(encoding="utf-8"))
+        run, = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == "run"]
+        calls = list(node for node in ast.walk(run) if isinstance(node, ast.Call))
+        def line(name):
+            nodes = [node for node in calls if (isinstance(node.func, ast.Name) and node.func.id == name)
+                or (isinstance(node.func, ast.Attribute) and node.func.attr == name)]
+            self.assertEqual(1, len(nodes), name)
+            return nodes[0].lineno
+        self.assertLess(line("execute"), line("cleanup_certified"))
+        self.assertLess(line("cleanup_certified"), line("archive_route"))
+        self.assertLess(line("archive_route"), line("reclaim_owned_state"))
+        loops = [node for node in ast.walk(run) if isinstance(node, ast.For)
+            and isinstance(node.iter, ast.Call) and isinstance(node.iter.func, ast.Name)
+            and node.iter.func.id == "enumerate"]
+        self.assertEqual(1, len(loops))
+        self.assertEqual("selection['routes']", ast.unparse(loops[0].iter.args[0]))
+        device_text = Path(device.__file__).read_text(encoding="utf-8")
+        self.assertIn('"pixel_6"', device_text)
+        self.assertIn('"-no-snapshot"', device_text)
+        self.assertIn('reporter_compile_deferred_until_storage_identity', device_text)
