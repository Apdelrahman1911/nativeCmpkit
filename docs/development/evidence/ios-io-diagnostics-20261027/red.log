ource-defined diagnostic subsets, never arbitrary task/profile input.\n      # Receipts explicitly mark these as incomplete suite coverage.\n      TEST_MODULES: ${{ matrix.test-modules }}\n      # These macOS desktop slots REQUIRE real AppKit GUI/cancellation execution.\n      # A headless/assumption skip is failure, never an eligible N/A or UI pass.\n      NATIVECMPKIT_NATIVE_UI_TESTS: ${{ matrix.native-ui || \'false\' }}\n      CARGO_BUILD_JOBS: \'2\'\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803\n        with:\n          persist-credentials: false\n      - uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961\n        with:\n          distribution: temurin\n          java-version: \'17\'\n          verify-signature: true\n          overwrite-settings: false\n      - uses: gradle/actions/wrapper-validation@3f5f9adaf7d9fecd50b5935e54106014257a94e6\n        with:\n          min-wrapper-count: 1\n          allow-snapshots: false\n      - name: Install the exact compiler using hosted-runner rustup (no bootstrap script)\n        run: |\n          command -v rustup\n          rustup toolchain install 1.98.0 --profile minimal --no-self-update --component rustfmt --component clippy\n      - name: Linux real UI/native prerequisites\n        if: runner.os == \'Linux\' && matrix.suite == \'desktop\'\n        timeout-minutes: 10\n        run: |\n          sudo apt-get update\n          sudo apt-get install --no-install-recommends -y libgtk-3-dev libwayland-dev xvfb xauth\n      - name: Provision SDK on every actual host, including Apple and Windows\n        uses: android-actions/setup-android@v3\n        with:\n          # v3\'s SDK16 bootstrap installs SDK23 through the official registry.\n          # SDK23 has distinct macOS arm64/x64 archives; do not invent mac URLs.\n          packages: ${{ matrix.suite == \'android-device\' && \'cmdline-tools;23.0 platforms;android-37.0 emulator system-images;android-35;google_apis;x86_64\' || \'cmdline-tools;23.0 platforms;android-37.0\' }}\n          accept-android-sdk-licenses: true\n          log-accepted-android-sdk-licenses: false\n      - name: Select the installed official SDK23 command-line tools\n        run: |\n          "$PYTHON" - <<\'PYTHON\'\n          import os\n          from pathlib import Path\n          home = Path(os.environ["ANDROID_HOME"])\n          manager = home / "cmdline-tools/23.0/bin" / ("sdkmanager.bat" if os.name == "nt" else "sdkmanager")\n          if not manager.is_file():\n              raise SystemExit("SDK23 provisioning did not create the expected manager")\n          with open(os.environ["GITHUB_PATH"], "a") as output:\n              output.write(str(manager.parent) + "\\n")\n          PYTHON\n      - name: Select the explicit real Chromium binary\n        if: matrix.suite == \'js\' || matrix.suite == \'wasm\'\n        run: |\n          CHROME_BIN="$(command -v google-chrome)"\n          test -x "$CHROME_BIN"\n          printf \'CHROME_BIN=%s\\n\' "$CHROME_BIN" >> "$GITHUB_ENV"\n      - name: Give only this ephemeral runner user the required KVM access\n        if: matrix.suite == \'android-device\'\n        run: |\n          test -c /dev/kvm\n          sudo apt-get install -y acl\n          sudo setfacl -m "u:$(id -un):rw" /dev/kvm\n          test -r /dev/kvm && test -w /dev/kvm\n      - name: Record actual architecture, compiler, SDK and selected simulator\n        id: runtime\n        run: |\n          args=(--expected-arch "$EXPECTED_ARCH" --require-clean --android-platform android-37.0)\n          if [[ "$SUITE" == ios ]]; then\n            "$PYTHON" scripts/ci/runtime_context.py "${args[@]}" --apple --select-simulator "$SIMULATOR_KIND" --output build/ci-runtime/selection.json\n            device="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/selection.json"))["simulator"]["udid"])\')"\n            state="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/selection.json"))["simulator"]["state"])\')"\n            if [[ "$state" == Shutdown ]]; then\n              xcrun simctl boot "$device"\n            elif [[ "$state" != Booted ]]; then\n              echo \'Unexpected selected simulator state; do not switch devices silently\' >&2\n              exit 1\n            fi\n            xcrun simctl bootstatus "$device" -b\n            args+=(--apple --simulator "$device" --require-booted)\n            printf \'device=%s\\n\' "$device" >> "$GITHUB_OUTPUT"\n          elif [[ "$SUITE" == js || "$SUITE" == wasm ]]; then\n            args+=(--browser)\n          fi\n          "$PYTHON" scripts/ci/runtime_context.py "${args[@]}" --output build/ci-runtime/actual.json\n          "$PYTHON" - <<\'PY\'\n          import json, os\n          context = json.load(open("build/ci-runtime/actual.json"))\n          with open(os.environ["GITHUB_OUTPUT"], "a") as output:\n              output.write("fingerprint=" + context["compiler_runtime_fingerprint"] + "\\n")\n          PY\n      - name: Record exact configured dependency inputs, not source commits or archives\n        id: cache-inputs\n        run: |\n          digest="$("$PYTHON" scripts/ci/dependency_cache_inputs.py --scope libraries --selection "$TEST_MODULES" --output build/ci-runtime/library-dependencies.json)"\n          [[ "$digest" =~ ^[0-9a-f]{64}$ ]]\n          selection="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/library-dependencies.json"))["selection_cache_key"])\')"\n          [[ "$selection" =~ ^(all|subset-[0-9a-f]{64})$ ]]\n          printf \'digest=%s\\nselection=%s\\n\' "$digest" "$selection" >> "$GITHUB_OUTPUT"\n      - name: Explicit dependency/compiler/runtime/slot-keyed cache\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9\n        with:\n          # No prefix restore keys, project outputs, native target dirs, build-cache\n          # entries, test XML or configuration caches. Hash verification/locks still\n          # need independent trust review; a cache is never build provenance.\n          key: nativecmpkit-deps-v2-${{ runner.os }}-${{ runner.arch }}-${{ matrix.slot }}-${{ matrix.suite }}-${{ steps.cache-inputs.outputs.selection }}-${{ steps.runtime.outputs.fingerprint }}-${{ steps.cache-inputs.outputs.digest }}\n          enableCrossOsArchive: false\n          path: |\n            ~/.gradle/wrapper/dists\n            ~/.gradle/caches/modules-2\n            ~/.cargo/registry/cache\n            ~/.cargo/registry/index\n            ~/.konan/dependencies\n      - name: Source-set-aware expected library tests (never samples)\n        id: plan\n        run: |\n          mkdir -p build/ci-plan\n          args=(plan --suite "$SUITE")\n          if [[ -n "$TEST_MODULES" ]]; then\n            IFS=\',\' read -ra modules <<< "$TEST_MODULES"\n            for module in "${modules[@]}"; do args+=(--module "$module"); done\n          fi\n          "$PYTHON" scripts/ci/library_tests.py "${args[@]}" > build/ci-plan/plan.json\n          "$PYTHON" - <<\'PY\'\n          import json, os\n          plan = json.load(open("build/ci-plan/plan.json"))\n          with open(os.environ["GITHUB_OUTPUT"], "a") as output:\n              output.write("reports<<NATIVECMPKIT_REPORTS\\n")\n              output.write("\\n".join(item["report_directory"] + "/**/TEST-*.xml" for item in plan["expected"]))\n              output.write("\\nNATIVECMPKIT_REPORTS\\n")\n          PY\n      - name: Fresh actual library suite with strict nonzero receipts\n        env:\n          SELECTED_SIMULATOR: ${{ steps.runtime.outputs.device }}\n        run: |\n          if [[ "$SUITE" == android-device ]]; then\n            args=(--api-level "$EMULATOR_API" --output "build/ci-verification/$SLOT")\n            if [[ -n "$TEST_MODULES" ]]; then\n              IFS=\',\' read -ra modules <<< "$TEST_MODULES"\n              for module in "${modules[@]}"; do args+=(--module "$module"); done\n            fi\n            "$PYTHON" scripts/ci/androi