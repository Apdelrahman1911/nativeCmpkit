[{"sha":"7898be39165470912ecfff77d9951d56b1201c51","node_id":"C_kwDOOAiZatoAKDc4OThiZTM5MTY1NDcwOTEyZWNmZmY3N2Q5OTUxZDU2YjEyMDFjNTE","commit":{"author":{"name":"Michelle Raouf","email":"michelle.raouf@52ndsolution.net","date":"2025-06-29T09:33:38Z"},"committer":{"name":"Michelle Raouf","email":"michelle.raouf@52ndsolution.net","date":"2025-06-29T09:33:38Z"},"message":"Fix camera image URL retrieval on iOS and bump dependencies\n\nThis commit addresses an issue on iOS where the camera picker was\nattempting to retrieve the image URL using `UIImagePickerControllerMediaURL`,\nwhich is intended for videos. This has been corrected to retrieve the\noriginal image using `UIImagePickerControllerOriginalImage`, save it to a\ntemporary file, and then provide the URL of this temporary file.\n\nThis change also ensures the picker delegate is strongly referenced to\nprevent premature deallocation and presents the picker controller on the\nmain thread. Additionally, it falls back to the photo library if the\ncamera is not available (e.g., on a simulator).\n\nThe sample app has been updated to display the retrieved image path.\n\nThe following dependencies have also been updated:\n- Android Gradle Plugin (AGP) from 8.7.3 to 8.10.1\n- Kotlin from 2.1.21 to 2.2.0\n- Compose from 1.8.1 to 1.8.2\n- Android compile SDK from 35 to 36\n- Compose Navigation from 2.9.0-beta02 to 2.9.0-beta03","tree":{"sha":"27f0228db2396a6f953202d001d2965d6ef30f54","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/27f0228db2396a6f953202d001d2965d6ef30f54"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/7898be39165470912ecfff77d9951d56b1201c51","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/7898be39165470912ecfff77d9951d56b1201c51","html_url":"https://github.com/MohamedRejeb/Calf/commit/7898be39165470912ecfff77d9951d56b1201c51","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/7898be39165470912ecfff77d9951d56b1201c51/comments","author":null,"committer":null,"parents":[{"sha":"fd480509a272ebc183208f8d965356bec296fb1c","url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/fd480509a272ebc183208f8d965356bec296fb1c","html_url":"https://github.com/MohamedRejeb/Calf/commit/fd480509a272ebc183208f8d965356bec296fb1c"}]},{"sha":"f0ffb539d61b60473f745a070183b17034e7f98b","node_id":"C_kwDOOAiZatoAKGYwZmZiNTM5ZDYxYjYwNDczZjc0NWEwNzAxODNiMTcwMzRlN2Y5OGI","commit":{"author":{"name":"Michelle Raouf","email":"michelle.raouf@52ndsolution.net","date":"2025-07-16T09:59:29Z"},"committer":{"name":"Michelle Raouf","email":"michelle.raouf@52ndsolution.net","date":"2025-07-16T09:59:29Z"},"message":"Upgrade Ktor and Kotlinx Datetime dependencies\n\nThis commit updates the following dependencies:\n- Ktor from version 3.1.3 to 3.2.2\n- Kotlinx Datetime from version 0.6.2 to 0.7.1\n- Compose Navigation for the sample app from version 2.9.0 to 2.9.0-beta03","tree":{"sha":"95ed95b06140a624f3fe843a2e4c19e46c4a21df","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/95ed95b06140a624f3fe843a2e4c19e46c4a21df"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/f0ffb539d61b60473f745a070183b17034e7f98b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/f0ffb539d61b60473f745a070183b17034e7f98b","html_url":"https://github.com/MohamedRejeb/Calf/commit/f0ffb539d61b60473f745a070183b17034e7f98b","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/f0ffb539d61b60473f745a070183b17034e7f98b/comments","author":null,"committer":null,"parents":[{"sha":"7898be39165470912ecfff77d9951d56b1201c51","url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/7898be39165470912ecfff77d9951d56b1201c51","html_url":"https://github.com/MohamedRejeb/Ca