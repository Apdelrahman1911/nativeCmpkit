[{"sha":"675d049f43dd502bc309d77b54c961533db37c2b","node_id":"C_kwDOKDql7toAKDY3NWQwNDlmNDNkZDUwMmJjMzA5ZDc3YjU0Yzk2MTUzM2RiMzdjMmI","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-13T05:24:17Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T09:44:07Z"},"message":"fix(file-picker): keep the requested file name in the iOS save sheet\n\nThe export picker shows, and saves under, the staged file's own name. The staged\ncopy was named <UUID>-<name>, so the sheet proposed the UUID. Each export is now\nstaged in a directory of its own and keeps the requested name; KmpFile exports\nare staged the same way instead of exporting the source under its own name.","tree":{"sha":"d34d3f8b541617988ca42caf0cb421675265d691","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/d34d3f8b541617988ca42caf0cb421675265d691"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/675d049f43dd502bc309d77b54c961533db37c2b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/675d049f43dd502bc309d77b54c961533db37c2b","html_url":"https://github.com/MohamedRejeb/Calf/commit/675d049f43dd502bc309d77b54c961533db37c2b","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/675d049f43dd502bc309d77b54c961533db37c2b/comments","author":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"af388bd3ad0325b2afdd8c0149cb7ff6f24c5da6","url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/af388bd3ad0325b2afdd8c0149cb7ff6f24c5da6","html_url":"https://github.com/MohamedRejeb/Calf/commit/af388bd3ad0325b2afdd8c0149cb7ff6f24c5da6"}]},{"sha":"e2ded9ff220bb11eecfe32678f8fc7206598f4e9","node_id":"C_kwDOKDql7toAKGUyZGVkOWZmMjIwYmIxMWVlY2ZlMzI2NzhmOGZjNzIwNjU5OGY0ZTk","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:24:54Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:24:54Z"},"message":"fix(io): KmpFile.getPath returns a file system path or null\n\ngetPath returned the URL string on iOS (file:///…%20…) and the content:// URI on\nAndroid, so callers that opened it as a path found nothing. It now returns a\ndecoded file system path, or null when the file has none: content: URIs on\nAndroid, non-file URLs on iOS, and every browser file. getName on iOS is decoded\ntoo.\n\ntoUriString() is new and returns the URI for callers that want it, such as the\nAndroid folder picker's initialDirectory. readByteArray on iOS opens\nsecurity-scoped URLs, so a KmpFile built from a picker URL by hand stays readable.\n\nBREAKING: code that relied on getPath returning a URI should call toUriString.","tree":{"sha":"cd97e5c61d99326cd9c06b7394a241b79206cd2e","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/cd97e5c61d99326cd9c06b7394a241b79206cd2e"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/e2ded9ff220bb11eecfe32678f8fc7206598f4e9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/e2ded9ff220bb11eecfe32678f8fc7206598f4e9","html_url":"https://github.com/MohamedRejeb/Calf/commit/e2ded9ff220bb11eecfe32678f8fc7206598f4e9","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/e2ded9ff220bb11eecfe32678f8fc7206598f4e9/comments","author":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"675d049f43dd502bc309d77b54c961533db37c2b","url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/675d049f43dd502bc309d77b54c961533db37c2b","html_url":"https://github.com/MohamedRejeb/Calf/commit/675d049f43dd502bc309d77b54c961533db37c2b"}]},{"sha":"be274cc530ff92e6e3bde9ac0ffbb912d5e3068a","node_id":"C_kwDOKDql7toAKGJlMjc0Y2M1MzBmZjkyZTZlM2JkZTlhYzBmZmJiOTEyZDVlMzA2OGE","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:25:02Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:25:02Z"},"message":"fix(file-picker): Android save writes the file; iOS exports a copy\n\nAndroid: the saver kept the pending source in a composition-local variable. The\nlauncher, created once, wrote to the first composition's variable, while the\nresult arrived in a later composition, after the save sheet paused and resumed\nthe activity, and read a null one. Every save produced an empty file. The source\nnow lives in a holder all compositions share, which also keeps a KmpFile source\nacross process death. The created document is typed after the extension instead\nof */*, and is deleted, with onResult(null), when nothing could be written.\n\niOS: the export sheet now saves a copy (asCopy) instead of offering to move the\nstaged file, and a source that cannot be staged reports null instead of\npresenting a sheet for a missing file.\n\nAndroid host tests run the real launcher on Robolectric, recomposing between\nlaunch and result. Modules with androidHostTest sources get the merged test\nmanifest that Robolectric needs to start the Compose activity.","tree":{"sha":"5cca459323fa9123b53528e2662261acdc1a9b24","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/5cca459323fa9123b53528e2662261acdc1a9b24"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/be274cc530ff92e6e3bde9ac0ffbb912d5e3068a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/be274cc530ff92e6e3bde9ac0ffbb912d5e3068a","html_url":"https://github.com/MohamedRejeb/Calf/commit/be274cc530ff92e6e3bde9ac0ffbb912d5e3068a","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/be274cc530ff92e6e3bde9ac0ffbb912d5e3068a/comments","author":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e2ded9ff220bb11eecfe32678f8fc7206598f4e9","url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/e2ded9ff220bb11eecfe32678f8fc7206598f4e9","html_url":"https://github.com/MohamedRejeb/Calf/commit/e2ded9ff220bb11eecfe32678f8fc7206598f4e9"}]},{"sha":"211d3ad9ecedb51d6794bb3945e9f9b2903b1afa","node_id":"C_kwDOKDql7toAKDIxMWQzYWQ5ZWNlZGI1MWQ2Nzk0YmIzOTQ1ZTlmOWIyOTAzYjFhZmE","commit":{"author":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:45:53Z"},"committer":{"name":"MohamedRejeb","email":"mohamedrejeb445@gmail.com","date":"2026-10-15T10:45:53Z"},"message":"fix(file-picker): report swipe dismissals and keep picked file names\n\niOS: the document picker and the save sheet only listened for\ndocumentPickerWasCancelled, which does not fire when a swipe starts before the\npresentation animation ends, so onResult was never called and the saver kept its\nstaged copy. Both now use one delegate that also handles\npresentationControllerDidDismiss behind a guard, so each presentation reports\nexactly one outcome.\n\niOS: picked files were copied to <UUID>.<ext>. Copies are now staged like exports,\ntmp/calf-file-picker/<UUID>/<original name>, so KmpFile.url keeps the real name\nand two picks of the same name never collide.\n\nAndroid: the saver crashed when no app handles ACTION_CREATE_DOCUMENT; it now\nreports null.","tree":{"sha":"ff89a78c45eaad762046a3546ebedc4fc39172b4","url":"https://api.github.com/repos/MohamedRejeb/Calf/git/trees/ff89a78c45eaad762046a3546ebedc4fc39172b4"},"url":"https://api.github.com/repos/MohamedRejeb/Calf/git/commits/211d3ad9ecedb51d6794bb3945e9f9b2903b1afa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/211d3ad9ecedb51d6794bb3945e9f9b2903b1afa","html_url":"https://github.com/MohamedRejeb/Calf/commit/211d3ad9ecedb51d6794bb3945e9f9b2903b1afa","comments_url":"https://api.github.com/repos/MohamedRejeb/Calf/commits/211d3ad9ecedb51d6794bb3945e9f9b2903b1afa/comments","author":{"login":"MohamedRejeb","id":4