+        # reference resumed output may omit this footer; first blank rows in
+        # finishing/stopping output can refuse before a later header is reached.
+        payload = (helper.ACTIVITIES_HEADER + "\nDisplay #0 (activities from top to bottom):\n" +
+                   row + "\n  (nothing)\n").encode()
+        try:
+            helper.parse_settings_activity_absence(subprocess.CompletedProcess(["synthetic-only"], 0, payload, b""))
+        except ValueError as error:
+            self.assertIs(type(error), ValueError)
+            self.assertEqual(error.args, ("Settings Activity absence traversal is unproved",))
+            self.assertEqual(helper.require_call_origin(error),
+                             {"source": HELPER_PATH.name, "symbol": "parse_settings_activity_absence", "line": 298})
+            frames = []; node = error.__traceback__
+            while node is not None:
+                frames.append(node); node = node.tb_next
+            self.assertIs(frames[-1].tb_frame.f_code, helper.require.__code__)
+            self.assertEqual(frames[-1].tb_lineno, 48)
+            COUNTERS["refused_row_samples"] += 1
+            return error, payload
+        self.fail("The unchanged strict display-row require must refuse every synthetic body")
