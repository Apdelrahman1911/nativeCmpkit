mpkit\' && github.event_name == \'workflow_dispatch\'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    outputs:\n      matrix: ${{ steps.plan.outputs.matrix }}\n      libraries: ${{ steps.plan.outputs.libraries }}\n      webviews: ${{ steps.plan.outputs.webviews }}\n      webview_matrix: ${{ steps.plan.outputs.webview_matrix }}\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - name: Verify complete history, audit and current development indexes\n        run: |\n          python3 scripts/migration/verify_migration.py\n          python3 scripts/audit/validate_audit.py\n          python3 scripts/audit/source_inventory.py --check\n          python3 scripts/development/validate_resolutions.py --check\n          python3 scripts/development/generate_icon_catalogues.py --check\n      - name: Offline verification-tool adversarial fixtures (not library passes)\n        run: |\n          for directory in scripts/audit scripts/migration scripts/development scripts/ci scripts/native scripts/dependencies scripts/dependencies/yarn scripts/docs tests/consumer; do\n            python3 -B -m unittest discover -s "$directory" -p \'test_*.py\' -v\n          done\n          python3 -B -m unittest discover -s scripts/development -p upstream_sync_tests.py -v\n      - name: Select only the requested verification profile\n        id: plan\n        env:\n          PROFILE: ${{ inputs.profile }}\n        run: |\n          mkdir -p build/ci-plan\n          python3 scripts/ci/workflow_matrix.py "$PROFILE" > build/ci-plan/matrix.json\n          python3 - <<\'PYTHON\'\n          import json, os, sys\n          sys.path.insert(0, "scripts/ci")\n          import webview_consumer\n          webview_matrix = webview_consumer.workflow_matrix(os.environ["PROFILE"])\n          matrix = json.load(open("build/ci-plan/matrix.json"))\n          with open(os.environ["GITHUB_OUTPUT"], "a") as output:\n              output.write("matrix=" + json.dumps(matrix, separators=(",", ":")) + "\\n")\n              output.write("libraries=" + str(bool(matrix["include"])).lower() + "\\n")\n              output.write("webview_matrix=" + json.dumps(webview_matrix, separators=(",", ":")) + "\\n")\n              output.write("webviews=" + str(bool(webview_matrix["include"])).lower() + "\\n")\n          PYTHON\n\n  library-tests:\n    needs: tooling\n    if: needs.tooling.outputs.libraries == \'true\'\n    strategy:\n      fail-fast: false\n      # The focused four-runtime continuation can coexist with one immutable\n      # UIKit diagnostic without exceeding two combined library jobs. Complete\n      # profiles retain two-way execution; no target or test is removed.\n      max-parallel: ${{ (inputs.profile == \'navigation-geo-matrix\' || inputs.profile == \'browser-coil-io\') && 1 || 2 }}\n      matrix: ${{ fromJSON(needs.tooling.outputs.matrix) }}\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 90\n    defaults:\n      run:\n        shell: bash\n    env:\n      # Explicit Git checkout bytes on all hosts. The prior Windows checkout\n      # converted 692 text inputs to CRLF; no broad normalization is a trust gate.\n      # Preserve long historical/evidence paths without renaming archives or\n      # changing machine-wide Git/Windows policy. Set BEFORE checkout executes.\n      GIT_CONFIG_COUNT: \'2\'\n      GIT_CONFIG_KEY_0: core.autocrlf\n      GIT_CONFIG_VALUE_0: \'false\'\n      GIT_CONFIG_KEY_1: core.longpaths\n      GIT_CONFIG_VALUE_1: \'true\'\n      PYTHON: ${{ matrix.python }}\n      SUITE: ${{ matrix.suite }}\n      SLOT: ${{ matrix.slot }}\n      EXPECTED_ARCH: ${{ matrix.arch }}\n      SIMULATOR_KIND: ${{ matrix.simulator-kind }}\n      EMULATOR_API: ${{ matrix.emulator-api }}\n      # Source-defined diagnostic subsets, never arbitrary task/profile input.\n      # Receipts explicitly mark these as incomplete suite coverage.\n      TEST_MODULES: ${{ matrix.test-modules }}\n      # Finite source-defined class filters; no free-form Gradle input.\n      TEST_FOCUS: ${{ matrix.test-focus }}\n      # These macOS desktop slots REQUIRE real AppKit GUI/cancellation execution.\n      # A headless/assumption skip is failure, never an eligible N/A or UI pass.\n      NATIVECMPKIT_NATIVE_UI_TESTS: ${{ matrix.native-ui || \'false\' }}\n      CARGO_BUILD_JOBS: \'2\'\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803\n        with:\n          persist-credentials: false\n      - uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961\n        with:\n          distribution: temurin\n          java-version: \'17\'\n          verify-signature: true\n          overwrite-settings: false\n      - uses: gradle/actions/wrapper-validation@3f5f9adaf7d9fecd50b5935e54106014257a94e6\n        with:\n          min-wrapper-count: 1\n          allow-snapshots: false\n      - name: Install the exact compiler using hosted-runner rustup (no bootstrap script)\n        run: |\n          command -v rustup\n          rustup toolchain install 1.98.0 --profile minimal --no-self-update --component rustfmt --component clippy\n      - name: Linux real UI/native prerequisites\n        if: runner.os == \'Linux\' && matrix.suite == \'desktop\'\n        timeout-minutes: 10\n        run: |\n          sudo apt-get update\n          sudo apt-get install --no-install-recommends -y libgtk-3-dev libwayland-dev xvfb xauth\n      - name: Provision SDK on every actual host, including Apple and Windows\n        uses: android-actions/setup-android@v3\n        with:\n          # v3\'s SDK16 bootstrap installs SDK23 through the official registry.\n          # SDK23 has distinct macOS arm64/x64 archives; do not invent mac URLs.\n          packages: ${{ matrix.suite == \'android-device\' && \'cmdline-tools;23.0 platforms;android-37.0 emulator system-images;android-35;google_apis;x86_64\' || \'cmdline-tools;23.0 platforms;android-37.0\' }}\n          accept-android-sdk-licenses: true\n          log-accepted-android-sdk-licenses: false\n      - name: Select the installed official SDK23 command-line tools\n        run: |\n          "$PYTHON" - <<\'PYTHON\'\n          import os\n          from pathlib import Path\n          home = Path(os.environ["ANDROID_HOME"])\n          manager = home / "cmdline-tools/23.0/bin" / ("sdkmanager.bat" if os.name == "nt" else "sdkmanager")\n          if not manager.is_file():\n              raise SystemExit("SDK23 provisioning did not create the expected manager")\n          with open(os.environ["GITHUB_PATH"], "a") as output:\n              output.write(str(manager.parent) + "\\n")\n          PYTHON\n      - name: Select the explicit real Chromium binary\n        if: matrix.suite == \'js\' || matrix.suite == \'wasm\'\n        run: |\n          CHROME_BIN="$(command -v google-chrome)"\n          test -x "$CHROME_BIN"\n          printf \'CHROME_BIN=%s\\n\' "$CHROME_BIN" >> "$GITHUB_ENV"\n      - name: Give only this ephemeral runner user the required KVM access\n        if: matrix.suite == \'android-device\'\n        run: |\n          test -c /dev/kvm\n          sudo apt-get install -y acl\n          sudo setfacl -m "u:$(id -un):rw" /dev/kvm\n          test -r /dev/kvm && test -w /dev/kvm\n      - name: Record actual architecture, compiler, SDK and selected simulator\n        id: runtime\n        run: |\n          args=(--expected-arch "$EXPECTED_ARCH" --require-clean --android-platform android-37.0)\n          if [[ "$SUITE" == ios ]]; then\n            "$PYTHON" scripts/ci/runtime_context.py "${args[@]}" --apple --select-simulator "$SIMULATOR_KIND" --output build/ci-runtime/selection.json\n            device="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/selection.json"))["simulator"]["udid"])\')"\n            state="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/selection.json"))["simulator"]["state"])\')"\n            if [[ "$state" == Shutdown ]]; then\n              xcrun simctl boot "$device"\n            elif [[ "$state" != Booted ]]; then\n              echo \'Unexpected selected simulator state; do not switch devices silently\' >&2\n              exit 1\n            fi\n            xcrun simctl bootstatus "$device" -b\n            args+=(--apple --simulator "$device" --require-booted)\n            printf \'device=%s\\n\' "$device" >> "$GITHUB_OUTPUT"\n          elif [[ "$SUITE" == js || "$SUITE" == wasm ]]; then\n            args+=(--browser)\n          fi\n          "$PYTHON" scripts/ci/runtime_context.py "${args[@]}" --output build/ci-runtime/actual.json\n          "$PYTHON" - <<\'PY\'\n          import json, os\n          context = json.load(open("build/ci-runtime/actual.json"))\n          with open(os.environ["GITHUB_OUTPUT"], "a") as output:\n              output.write("fingerprint=" + context["compiler_runtime_fingerprint"] + "\\n")\n          PY\n      - name: Record exact configured dependency inputs, not source commits or archives\n        id: cache-inputs\n        run: |\n          digest="$("$PYTHON" scripts/ci/dependency_cache_inputs.py --scope libraries --selection "$TEST_MODULES" --output build/ci-runtime/library-dependencies.json)"\n          [[ "$digest" =~ ^[0-9a-f]{64}$ ]]\n          selection="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/library-dependencies.json"))["selection_cache_key"])\')"\n          [[ "$selection" =~ ^(all|subset-[0-9a-f]{64})$ ]]\n          printf \'digest=%s\\nselection=%s\\n\' "$digest" "$selection" >> "$GITHUB_OUTPUT"\n      - name: Explicit dependency/compiler/runtime/slot-keyed cache\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9\n        with:\n          # No prefix restore keys, project outputs, native target dirs, build-cache\n          # entries, test XML or configuration caches. Hash verification/locks still\n          # need independent trust review; a cache is never build provenance.\n          key: nativecmpkit-deps-v2-${{ runner.os }}-${{ runner.arch }}-${{ matrix.slot }}-${{ matrix.suite }}-${{ steps.cache-inputs.outputs.selection }}-${{ steps.runtime.outputs.fingerprint }}-${{ steps.cache-inputs.outputs.digest }}\n          enableCrossOsArchive: false\n          path: |\n            ~/.gradle/wrapper/dists\n            ~/.gradle/caches/modules-2\n            ~/.cargo/registry/cache\n            ~/.cargo/registry/index\n            ~/.konan/dependencies\n      - name: Source-set-aware expected library tests (never samples)\n        id: plan\n        run: |\n          mkdir -p build/ci-plan\n          args=(plan --suite "$SUITE")\n          if [[ -n "$TEST_FOCUS" ]]; then args+=(--focus "$TEST_FOCUS"); fi\n          if [[ -n "$TEST_MODULES" ]]; then\n            IFS=\',\' read -ra modules <<< "$TEST_MODULES"\n            for module in "${modules[@]}"; do args+=(--module "$module"); done\n          fi\n          "$PYTHON" scripts/ci/library_tests.py "${args[@]}" > build/ci-plan/plan.json\n          "$PYTHON" - <<\'PY\'\n          import json, os\n          plan = json.load(open("build/ci-plan/plan.json"))\n          with open(os.environ["GITHUB_OUTPUT"], "a") as output:\n              output.write("reports<<NATIVECMPKIT_REPORTS\\n")\n              output.write("\\n".join(item["report_directory"] + "/**/TEST-*.xml" for item in plan["expected"]))\n              output.write("\\nNATIVECMPKIT_REPORTS\\n")\n          PY\n      - name: Fresh actual library suite with strict nonzero receipts\n        env:\n          SELECTED_SIMULATOR: ${{ steps.runtime.outputs.device }}\n        run: |\n          if [[ "$SUITE" == android-device ]]; then\n            args=(--api-level "$EMULATOR_API" --output "build/ci-verification/$SLOT")\n            if [[ -n "$TEST_FOCUS" ]]; then args+=(--focus "$TEST_FOCUS"); fi\n            if [[ -n "$TEST_MODULES" ]]; then\n              IFS=\',\' read -ra modules <<< "$TEST_MODULES"\n              for module in "${modules[@]}"; do args+=(--module "$module"); done\n            fi\n            "$PYTHON" scripts/ci/android_device_tests.py "${args[@]}"\n            exit\n          fi\n          args=(run --suite "$SUITE" --output "build/ci-verification/$SLOT" --timeout 4200 --reserve-mib 8192)\n          if [[ -n "$TEST_FOCUS" ]]; then args+=(--focus "$TEST_FOCUS"); fi\n          if [[ -n "$TEST_MODULES" ]]; then\n            IFS=\',\' read -ra modules <<< "$TEST_MODULES"\n            for module in "${modules[@]}"; do args+=(--module "$module"); done\n          fi\n          if [[ "$SUITE" == ios ]]; then\n            args+=(--simulator "$SELECTED_SIMULATOR")\n          fi\n          if [[ "$RUNNER_OS" == Linux ]]; then\n            xvfb-run -a "$PYTHON" scripts/ci/library_tests.py "${args[@]}"\n          else\n            "$PYTHON" scripts/ci/library_tests.py "${args[@]}"\n          fi\n      - name: Show bounded failure diagnostics from public library fixtures\n        if: failure()\n        run: |\n          # Preserve early connected-task/UTP failures even when the final Gradle\n          # stack trace consumes the old 180-line tail. JSON contains bounded\n          # excerpts/inert result-file hashes, never packages or complete logs.\n          if [[ -d "build/ci-verification/$SLOT" ]]; then\n            "$PYTHON" scripts/ci/failure_diagnostics.py --output "build/ci-verification/$SLOT"\n          fi\n          # No credentials/private applications are configured in this workflow.\n          # Print only the owned Gradle log tail, not runner environment or caches.\n          "$PYTHON" - <<\'PYTHON\'\n          from pathlib import Path\n          import os, re\n          root = Path("build/ci-verification") / os.environ["SLOT"]\n          paths = [root / "gradle.log", root / "library/gradle.log", root / "apk-assembly.log", root / "owned-avd-create.log", root / "emulator.log"]\n          for path in paths:\n            if not path.is_file():\n              continue\n            print("Owned diagnostic:", path.name)\n            with path.open("rb") as stream:\n                stream.seek(max(0, path.stat().st_size - 65536))\n                tail = stream.read(65536).decode("utf-8", errors="replace").splitlines()[-180:]\n            for line in tail:\n                if re.search(r"(?i)(authorization|password|passwd|secret|token|credential|BEGIN .*PRIVATE KEY|[?&]sig=)", line):\n                    print("[redacted credential-related diagnostic line]")\n                else:\n                    print(line[:2000])\n          if not any(path.is_file() for path in paths):\n              print("No Gradle log: failure preceded library execution; inspect setup steps.")\n          PYTHON\n      - name: Keep receipts and actual selected-task XML only; never packages\n        if: always()\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n        with:\n          name: library-evidence-${{ matrix.slot }}\n          retention-days: 7\n          if-no-files-found: error\n          path: |\n            build/ci-runtime/*.json\n            build/ci-plan/*.json\n            build/ci-verification/${{ matrix.slot }}/*.json\n            build/ci-verification/${{ matrix.slot }}/library/*.json\n            build/ci-verification/${{ matrix.slot }}/native-ui-application/*/receipt.json\n            ${{ steps.plan.outputs.reports }}\n\n  webview-consumer:\n    needs: tooling\n    if: needs.tooling.outputs.webviews == \'true\' && github.ref == \'refs/heads/development/preview-hardening\'\n    strategy:\n      fail-fast: false\n      max-parallel: 2\n      matrix: ${{ fromJSON(needs.tooling.outputs.webview_matrix) }}\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 85\n    defaults:\n      run:\n        shell: bash\n    env:\n      GIT_CONFIG_COUNT: \'2\'\n      GIT_CONFIG_KEY_0: core.autocrlf\n      GIT_CONFIG_VALUE_0: \'false\'\n      GIT_CONFIG_KEY_1: core.longpaths\n      GIT_CONFIG_VALUE_1: \'true\'\n      PYTHON: ${{ matrix.python }}\n      HOST: ${{ matrix.host }}\n      EXPECTED_ARCH: ${{ matrix.arch }}\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803\n        with:\n          persist-credentials: false\n      - uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961\n        with:\n          distribution: temurin\n          java-version: \'17\'\n          verify-signature: true\n          overwrite-settings: false\n      - uses: gradle/actions/wrapper-validation@3f5f9adaf7d9fecd50b5935e54106014257a94e6\n        with:\n          min-wrapper-count: 1\n          allow-snapshots: false\n      - name: Exact public compiler context, without bootstrap scripts\n        run: rustup toolchain install 1.98.0 --profile minimal --no-self-update\n      - name: Linux graphical JavaFX prerequisites\n        if: runner.os == \'Linux\'\n        run: |\n          sudo apt-get update\n          sudo apt-get install --no-install-recommends -y libgtk-3-dev xvfb xauth\n      - uses: android-actions/setup-android@v3\n        with:\n          packages: \'cmdline-tools;23.0 platforms;android-37.0\'\n          accept-android-sdk-licenses: true\n          log-accepted-android-sdk-licenses: false\n      - name: Record actual host and configured compiler context\n        id: runtime\n        run: |\n          "$PYTHON" scripts/ci/runtime_context.py --expected-arch "$EXPECTED_ARCH" --require-clean --android-platform android-37.0 --output build/ci-runtime/webview.json\n          fingerprint="$("$PYTHON" -c \'import json; print(json.load(open("build/ci-runtime/webview.json"))["compiler_runtime_fingerprint"])\')"\n          printf \'fingerprint=%s\\n\' "$fingerprint" >> "$GITHUB_OUTPUT"\n      - name: Exact configured WebView dependency inputs only\n        id: cache-inputs\n        run: |\n          digest="$("$PYTHON" scripts/ci/dependency_cache_inputs.py --scope webview --output build/ci-runtime/webview-dependencies.json)"\n          printf \'digest=%s\\n\' "$digest" >> "$GITHUB_OUTPUT"\n      - name: Exact producer dependencies only, never consumers or artifacts\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9\n        with:\n          key: nativecmpkit-webview-producer-v2-${{ matrix.host }}-${{ steps.runtime.outputs.fingerprint }}-${{ steps.cache-inputs.outputs.digest }}\n          path: |\n            build/ci-consumer-cache/webview-producer-gradle/wrapper/dists\n            build/ci-consumer-cache/webview-producer-gradle/caches/modules-2\n      - name: Fresh independent module and POM consumers using the real public WebView\n        run: |\n          if [[ "$RUNNER_OS" == Linux ]]; then\n            xvfb-run -a "$PYTHON" scripts/ci/webview_consumer.py --host "$HOST" --output "build/ci-webview-consumer/$HOST" --timeout 4200\n          else\n            "$PYTHON" scripts/ci/webview_consumer.py --host "$HOST" --output "build/ci-webview-consumer/$HOST" --timeout 4200\n          fi\n      - name: Exact bounded public consumer build errors, never full logs or environment\n        if: failure()\n        run: |\n          "$PYTHON" - <<\'PYTHON\'\n          import json, os\n          from pathlib import Path\n          path = Path("build/ci-webview-consumer") / os.environ["HOST"] / "failure-diagnostics.json"\n          if path.is_file():\n              print(json.dumps(json.loads(path.read_text()), indent=2))\n          PYTHON\n      - name: Keep bounded JSON and original XML only, not candidate packages or logs\n        if: always()\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n        with:\n          name: webview-consumer-evidence-${{ matrix.host }}\n          if-no-files-found: error\n          retention-days: 7\n          path: |\n            build/ci-runtime/webview.json\n            build/ci-runtime/webview-dependencies.json\n            build/ci-webview-consumer/${{ matrix.host }}/*.json\n            build/ci-webview-consumer/${{ matrix.host }}/module/*.json\n            build/ci-webview-consumer/${{ matrix.host }}/pom/*.json\n            build/ci-webview-consumer/${{ matrix.host }}/module/junit/TEST-*.xml\n            build/ci-webview-consumer/${{ matrix.host }}/pom/junit/TEST-*.xml\n\n\n  consumer-core-io:\n    needs: tooling\n    # Do not pretend this two-root diagnostic covers all21 roots or repeat the\n    # already-selected library/platform suites. Full consumer gates stay open.\n    if: inputs.profile == \'consumer-core-io\'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 90\n    defaults:\n      run:\n        shell: bash\n    env:\n      CARGO_BUILD_JOBS: \'2\'\n      GIT_CONFIG_COUNT: \'1\'\n      GIT_CONFIG_KEY_0: core.autocrlf\n      GIT_CONFIG_VALUE_0: \'false\'\n    steps:\n      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803\n        with:\n          persist-credentials: false\n      - uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961\n        with:\n          distribution: temurin\n          java-version: \'17\'\n          verify-signature: true\n          overwrite-settings: false\n      - uses: gradle/actions/wrapper-validation@3f5f9adaf7d9fecd50b5935e54106014257a94e6\n        with:\n          min-wrapper-count: 1\n          allow-snapshots: false\n      - name: Select the same exact installed compiler for the runtime receipt\n        run: |\n          command -v rustup\n          rustup toolchain install 1.98.0 --profile minimal --no-self-update --component rustfmt --component clippy\n          # Preserve the current actual rustup installation when the controller\n          # gives its children a private HOME. Export paths, never credentials.\n          printf \'RUSTUP_HOME=%s\\n\' "${RUSTUP_HOME:-$HOME/.rustup}" >> "$GITHUB_ENV"\n          printf \'CARGO_HOME=%s\\n\' "${CARGO_HOME:-$HOME/.cargo}" >> "$GITHUB_ENV"\n      - name: Provision the required official Android SDK for producer configuration\n        uses: android-actions/setup-android@v3\n        with:\n          packages: \'cmdline-tools;23.0 platforms;android-37.0\'\n          accept-android-sdk-licenses: true\n          log-accepted-android-sdk-licenses: false\n      - name: Record the actual immutable producer/consumer host and SDK\n        id: runtime\n        run: |\n          mkdir -p build/ci-runtime\n          python3 scripts/ci/runtime_context.py --expected-arch x64 --require-clean --android-platform android-37.0 --output build/ci-runtime/consumer-core-io.json\n          python3 - <<\'PYTHON\'\n          import json, os\n          context = json.load(open("build/ci-runtime/consumer-core-io.json"))\n          with open(os.environ["GITHUB_OUTPUT"], "a") as output:\n              output.write("fingerprint=" + context["compiler_runtime_fingerprint"] + "\\n")\n          PYTHON\n      - name: Record the configured dependency and independent consumer recipes\n        id: cache-inputs\n        run: |\n          digest="$(python3 scripts/ci/dependency_cache_inputs.py --scope core-io --output build/ci-runtime/consumer-dependencies.json)"\n          [[ "$digest" =~ ^[0-9a-f]{64}$ ]]\n          printf \'digest=%s\\n\' "$digest" >> "$GITHUB_OUTPUT"\n      - name: Exact dependency-input/runtime-keyed producer cache, never candidate binaries or XML\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9\n        with:\n          # No prefix restore keys or build outputs. Caches remain untrusted\n          # dependency observations; this partial job does not certify trust.\n          # The child Gradle home is fresh under the confined output, NEVER here.\n          # The controller fails on a candidate group in producer modules-2\n          # before/after either phase; a failed job cannot save this cache.\n          key: nativecmpkit-core-io-deps-v2-${{ runner.os }}-${{ runner.arch }}-${{ steps.runtime.outputs.fingerprint }}-${{ steps.cache-inputs.outputs.digest }}\n          enableCrossOsArchive: false\n          path: |\n            build/ci-consumer-cache/gradle-home/wrapper/dists\n            build/ci-consumer-cache/gradle-home/caches/modules-2\n      - name: Stage four actual local publications and execute the independent seven-method consumer\n        run: |\n          python3 scripts/ci/core_io_consumer.py --output build/ci-consumer/core-io-desktop --timeout 4200 --reserve-mib 8192\n      - name: Bounded public-fixture failure context, not environment or cache dumps\n        if: failure()\n        run: |\n          python3 - <<\'PYTHON\'\n          from pathlib import Path\n          import json, re\n          root = Path("build/ci-consumer/core-io-desktop")\n          receipt = root / "receipt.json"\n          if receipt.is_file():\n              record = json.loads(receipt.read_text())\n              print(json.dumps({k: record[k] for k in ("passed", "error", "actual_consumer_methods_verified", "release_readiness_certified") if k in record}))\n          for name in ("producer.log", "consumer.log"):\n              path = root / name\n              if not path.is_file():\n                  continue\n              print("Owned partial consumer diagnostic:", name)\n              with path.open("rb") as stream:\n                  stream.seek(max(0, path.stat().st_size - 65536))\n                  tail = stream.read(65536).decode("utf-8", errors="replace").splitlines()[-140:]\n              for line in tail:\n                  if re.search(r"(?i)(authorization|password|passwd|secret|token|credential|BEGIN .*PRIVATE KEY|[?&]sig=)", line):\n                      print("[redacted credential-related diagnostic line]")\n                  else:\n                      print(line[:2000])\n          PYTHON\n      - name: Keep partial receipts and fresh consumer XML only, never staged packages\n        if: always()\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n        with:\n          name: partial-consumer-core-io-desktop\n          retention-days: 7\n          if-no-files-found: error\n          path: |\n            build/ci-runtime/consumer-core-io.json\n            build/ci-runtime/consumer-dependencies.json\n            build/ci-consumer/core-io-desktop/*.json\n            build/ci-consumer/core-io-desktop/junit/TEST-*.xml\n'
