  "findings": [
    {
      "claim": "Distribution classpath resolution precedes setup actions; an installed executable is not the offline archive/resolver prerequisite.",
      "sources": [
        "AbstractSetupTask.kt:93-98",
        "AbstractSetupTask$dist$2.invoke",
        "AbstractSetupTask$dist$2$1.invoke",
        "AbstractSetupTask.getDist Classpath annotation"
      ]
    },
    {
      "claim": "onlyIf checks shouldDownload, not destination directory readiness.",
      "sources": [
        "AbstractSetupTask.kt:111",
        "AbstractSetupTask$1.isSatisfiedBy"
      ]
    },
    {
      "claim": "Setup may delete/extract destination and write sibling .hash; an up-to-date check still hashes the distribution archive. Do not manufacture a marker or run setup.",
      "sources": [
        "AbstractSetupTask.kt:80-81,158-180,191-220",
        "AbstractSetupTask$destinationHashFileProvider$1.transform",
        "AbstractSetupTask.extractWithUpToDate",
        "AbstractSetupTask.isUpToDate"
      ]
    },
    {
      "claim": "Node extractor copies tar/zip archive root into destination parent, then repairs symlinks/sets executable; none is required for the minimal cache probe.",
      "sources": [
        "NodeJsSetupTask.kt:39-54",
        "NodeJsSetupTask$extract$1.execute",
        "NodeJsSetupTask.extract"
      ]
    },
    {
      "claim": "Artifact store groups by component group/module/version; its content key is internal SHA1, not authenticated release SHA256.",
      "sources": [
        "DefaultArtifactIdentifierFileStore$1.determineGroup",
        "GroupedAndNamedUniqueFileStore.java:69-90,105-108",
        "GroupedAndNamedUniqueFileStore.toPath/getChecksum/add/move"
      ]
    },
    {
      "claim": "Module and artifact cache lookup keys include repository identity; module descriptors and indexes are serialized/updated through normal locked cache APIs. A file or manual index copy is not resolver readiness.",
      "sources": [
        "ModuleComponentAtRepositoryKey.<init>/equals/hashCode",
        "ArtifactAtRepositoryKey.<init>/equals/hashCode",
        "ModuleMetadataStore.java:68-86",
        "PersistentModuleMetadataCache.java:71,97-107",
        "CachingModuleComponentRepository$LocateInCacheRepositoryAccess.resolveComponentMetaDataFromCache/resolveArtifactFromCache",
        "CachingModuleComponentRepository$ResolveAndCacheRepositoryAccess.resolveComponentMetaDataAndCache/resolveArtifact"
      ]
    },
    {
      "claim": "Repository ID inputs include resolver class, resource pattern lists, metadata source labels and Ivy M2 flag; preserve the exact official KGP repository definition, not a file URL/mirror or added Ivy/POM pattern. Actual runtime ID remains unexecuted.",
      "sources": [
        "UrlRepositoryDescriptor.java:118-133",
        "IvyRepositoryDescriptor.java:162-177",
        "DefaultIvyArtifactRepository.createDescriptor",
        "sealed original AbstractSetupTask$withUrlRepo$repo$1$1.execute"
      ]
    },
    {
      "claim": "metadataSources resets defaults; artifact-only enables artifact label only. Default pattern layout derives Ivy resource patterns from artifact patterns when explicit Ivy patterns are empty.",
      "sources": [
        "DefaultIvyArtifactRepository.java:219-222,451-496",
        "DefaultIvyPatternRepositoryLayout.java:70-86"
      ]
    },
    {
      "claim": "Strict SHA256 verification blueprint is separate from mandatory external release-signature/key authentication. Missing placeholders deliberately prevent admission; XML parsing is a static readback only.",
      "sources": [
        "DependencyVerificationsXmlReader$VerifiersHandler.startElement/characters/createArtifactId/createComponentId",
        "blueprints/build.gradle.in",
        "blueprints/verification-metadata.xml.in"
      ]
    },
    {
      "claim": "Fresh private cache success would cover only the standalone exact Node resolution, not original U1 home, graph/gate denial or later dependency planning.",
      "sources": [
        "original retained U1 outcome",
        "LEAD-PLAN.md"
      ]
    }
  ],
