+    ("desktop-linux-x64", FOCUS, "Linux", "x86_64", 1, 1),
+    ("desktop-macos-arm64", STOP_FOCUS, "Darwin", "arm64", 2, 2),
+    ("desktop-windows-x64", STOP_FOCUS, "Windows", "AMD64", 2, 2),
