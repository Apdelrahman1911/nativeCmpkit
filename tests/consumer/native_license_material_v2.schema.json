{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nativecmpkit:pending-license-material:v2",
  "title": "Pending exact objc2 dual-origin license evidence",
  "description": "Inert review schema only. Raw original crate/source and separate text-origin commits are distinct. Object integrity cannot clear old-release applicability, contributor, SDK or publisher obligations. The v1 collector cannot load this schema.",
  "$comment": "A caller must provide an independently reviewed index SHA256. The adapter also binds every blob path through the actual raw commit/root/intermediate trees, resolves exact original Cargo workspace inheritance, and checks both current locks. No JSON Schema structural match is an authenticity or legal attestation.",
  "oneOf": [{"$ref": "#/$defs/material"}, {"$ref": "#/$defs/materialSet"}],
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))(?!.*//)[^\\u0000-\\u001f\\\\]+$", "$comment": "The adapter additionally requires canonical POSIX paths and bounded no-follow regular bytes."},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}}, "required": ["catalog_path", "bytes", "sha256"]},
    "gitObject": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}, "git_oid": {"$ref": "#/$defs/gitOid"}}, "required": ["catalog_path", "bytes", "sha256", "git_oid"]},
    "gitFile": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}, "path": {"$ref": "#/$defs/path"}, "git_blob_oid": {"$ref": "#/$defs/gitOid"}}, "required": ["catalog_path", "bytes", "sha256", "path", "git_blob_oid"]},
    "crateFile": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}, "path": {"enum": [".cargo_vcs_info.json", "Cargo.toml", "Cargo.toml.orig"]}}, "required": ["catalog_path", "bytes", "sha256", "path"]},
    "licenseFile": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}, "path": {"$ref": "#/$defs/path"}, "git_blob_oid": {"$ref": "#/$defs/gitOid"}, "license_id": {"enum": ["MIT", "Apache-2.0", "Zlib"]}, "copyright_literal": {"const": "Copyright 2026 Mads Marquart"}}, "required": ["catalog_path", "bytes", "sha256", "path", "git_blob_oid", "license_id", "copyright_literal"]},
    "sourceOrigin": {"type": "object", "additionalProperties": false, "properties": {"repository": {"const": "https://github.com/madsmtm/objc2"}, "revision": {"$ref": "#/$defs/gitOid"}, "git_commit": {"$ref": "#/$defs/gitObject"}, "git_trees": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/gitObject"}}, "publisher_signature_verified": {"const": false}}, "required": ["repository", "revision", "git_commit", "git_trees", "publisher_signature_verified"]},
    "textOrigin": {"type": "object", "additionalProperties": false, "properties": {"repository": {"const": "https://github.com/madsmtm/objc2"}, "revision": {"const": "ee9a7ada2131f5944b8750428e265c15632f2a19"}, "git_commit": {"$ref": "#/$defs/gitObject"}, "git_trees": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/gitObject"}}, "publisher_signature_verified": {"const": false}}, "required": ["repository", "revision", "git_commit", "git_trees", "publisher_signature_verified"]},
    "leadOrigin": {"type": "object", "additionalProperties": false, "properties": {"repository": {"const": "https://github.com/SSheldon/rust-objc"}, "revision": {"const": "c8696b0cd1932fdf1b5b22c03af86f32a934f42f"}, "git_commit": {"$ref": "#/$defs/gitObject"}, "git_trees": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/gitObject"}}, "publisher_signature_verified": {"const": false}}, "required": ["repository", "revision", "git_commit", "git_trees", "publisher_signature_verified"]},
    "package": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "name": {"enum": ["block2", "dispatch2", "objc2", "objc2-app-kit", "objc2-cloud-kit", "objc2-core-data", "objc2-core-foundation", "objc2-core-graphics", "objc2-core-image", "objc2-core-text", "objc2-core-video", "objc2-encode", "objc2-foundation", "objc2-io-surface", "objc2-quartz-core"]}, "version": {"type": "string", "minLength": 1}, "checksum": {"$ref": "#/$defs/sha256"}, "license": {"enum": ["MIT", "Zlib OR Apache-2.0 OR MIT"]}, "source_kind": {"const": "crates.io"}, "license_file": {"const": null}}, "required": ["id", "name", "version", "checksum", "license", "source_kind", "license_file"]},
    "obligations": {"type": "object", "const": {"exact_release_text_applicability": "unreviewed", "contributor_notices": "unreviewed", "sdk_source_and_distribution": "unreviewed", "selected_license_option": null, "license_obligations_reviewed": false, "complete_material_collection": false, "ready_for_staging": false, "publisher_provenance_verified": false}},
    "inputFile": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}, "source_path": {"enum": ["calf-file-picker/native/Cargo.lock", "calf-file-picker/native/Cargo.toml", "calf-share/native/Cargo.lock", "calf-share/native/Cargo.toml"]}}, "required": ["catalog_path", "bytes", "sha256", "source_path"]},
    "packageManifest": {"type": "object", "additionalProperties": false, "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"}, "package": {"$ref": "#/$defs/package"}}, "required": ["catalog_path", "bytes", "sha256", "package"]},
    "material": {"type": "object", "additionalProperties": false, "properties": {"schema_version": {"const": 2}, "kind": {"const": "pending-dual-origin-license-material"}, "scope": {"const": "Pending exact objc2 dual-origin material; no legal, publisher or staging clearance"}, "package": {"$ref": "#/$defs/package"}, "crate_files": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/crateFile"}}, "source_origin": {"$ref": "#/$defs/sourceOrigin"}, "source_files": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/gitFile"}}, "path_in_vcs": {"$ref": "#/$defs/path"}, "text_origin": {"$ref": "#/$defs/textOrigin"}, "policy_file": {"$ref": "#/$defs/gitFile"}, "license_files": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/licenseFile"}}, "license_resolution": {"type": "object", "additionalProperties": false, "properties": {"original_license_field": {"oneOf": [{"const": "MIT"}, {"type": "object", "additionalProperties": false, "properties": {"workspace": {"const": true}}, "required": ["workspace"]}]}, "resolved_license": {"enum": ["MIT", "Zlib OR Apache-2.0 OR MIT"]}, "mode": {"enum": ["package-override", "workspace-inherited"]}}, "required": ["original_license_field", "resolved_license", "mode"]}, "relationship": {"type": "object", "additionalProperties": false, "properties": {"evidence": {"$ref": "#/$defs/file"}, "status": {"enum": ["ahead", "diverged"]}, "source_is_ancestor_reported": {"type": "boolean"}, "merge_base_revision": {"$ref": "#/$defs/gitOid"}, "raw_history_verified": {"const": false}}, "required": ["evidence", "status", "source_is_ancestor_reported", "merge_base_revision", "raw_history_verified"]}, "attribution_lead": {"type": "object", "additionalProperties": false, "properties": {"origin": {"$ref": "#/$defs/leadOrigin"}, "notice_file": {"$ref": "#/$defs/gitFile"}, "applicability": {"const": "unreviewed"}}, "required": ["origin", "notice_file", "applicability"]}, "research_files": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/file"}}, "obligations": {"$ref": "#/$defs/obligations"}}, "required": ["schema_version", "kind", "scope", "package", "crate_files", "source_origin", "source_files", "path_in_vcs", "text_origin", "policy_file", "license_files", "license_resolution", "relationship", "attribution_lead", "research_files", "obligations"], "allOf": [{"if": {"properties": {"package": {"properties": {"name": {"enum": ["block2", "objc2", "objc2-encode", "objc2-foundation"]}}}}}, "then": {"properties": {"package": {"properties": {"license": {"const": "MIT"}}}, "license_files": {"maxItems": 1, "items": {"properties": {"license_id": {"const": "MIT"}}}}}}, "else": {"properties": {"package": {"properties": {"license": {"const": "Zlib OR Apache-2.0 OR MIT"}}}, "license_files": {"minItems": 3, "maxItems": 3, "allOf": [{"contains": {"properties": {"license_id": {"const": "MIT"}}}}, {"contains": {"properties": {"license_id": {"const": "Apache-2.0"}}}}, {"contains": {"properties": {"license_id": {"const": "Zlib"}}}}]}}}}]},
    "materialSet": {"type": "object", "additionalProperties": false, "properties": {"schema_version": {"const": 2}, "kind": {"const": "pending-dual-origin-license-material-set"}, "scope": {"const": "Pending exact objc2 dual-origin material; no legal, publisher or staging clearance"}, "inputs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/inputFile"}}, "packages": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/packageManifest"}}, "obligations": {"$ref": "#/$defs/obligations"}}, "required": ["schema_version", "kind", "scope", "inputs", "packages", "obligations"]}
  }
}
