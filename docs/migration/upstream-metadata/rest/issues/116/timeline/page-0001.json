= skipPartiallyExpanded,\r\n            confirmValueChange = confirmValueChange\r\n        )\r\n    ) {\r\n        AdaptiveSheetState(skipPartiallyExpanded, sheetValueHolder.value, confirmValueChange)\r\n    }\r\n\r\n\r\n    LaunchedEffect(state.currentValue) {\r\n        sheetValueHolder.value = state.currentValue\r\n    }\r\n\r\n    return state\r\n}\r\n```","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/2246952423/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","following_url":"https://api.github.com/users/MohamedRejeb/following{/other_user}","gists_url":"https://api.github.com/users/MohamedRejeb/gists{/gist_id}","starred_url":"https://api.github.com/users/MohamedRejeb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MohamedRejeb/subscriptions","organizations_url":"https://api.github.com/users/MohamedRejeb/orgs","repos_url":"https://api.github.com/users/MohamedRejeb/repos","events_url":"https://api.github.com/users/MohamedRejeb/events{/privacy}","received_events_url":"https://api.github.com/users/MohamedRejeb/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.githubusercontent.com/u/41842296?v=4","gravatar_id":"","url":"https://api.github.com/users/MohamedRejeb","html_url":"https://github.com/MohamedRejeb","followers_url":"https://api.github.com/users/MohamedRejeb/followers","follow