+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
+        print("Owned appinfo SDK prerequisite refused: " + type(error).__name__, file=sys.stderr)
+        sys.exit(2)
