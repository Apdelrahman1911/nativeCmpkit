github_app":null,"minimized":null,"event":"commented","actor":{"login":"ganluo960214","id":8499204,"node_id":"MDQ6VXNlcjg0OTkyMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/8499204?v=4","gravatar_id":"","url":"https://api.github.com/users/ganluo960214","html_url":"https://github.com/ganluo960214","followers_url":"https://api.github.com/users/ganluo960214/followers","following_url":"https://api.github.com/users/ganluo960214/following{/other_user}","gists_url":"https://api.github.com/users/ganluo960214/gists{/gist_id}","starred_url":"https://api.github.com/users/ganluo960214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ganluo960214/subscriptions","organizations_url":"https://api.github.com/users/ganluo960214/orgs","repos_url":"https://api.github.com/users/ganluo960214/repos","events_url":"https://api.github.com/users/ganluo960214/events{/privacy}","received_events_url":"https://api.github.com/users/ganluo960214/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/2354616616","html_url":"https://github.com/MohamedRejeb/Calf/pull/179#issuecomment-2354616616","issue_url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/179","id":2354616616,"node_id":"IC_kwDOKDql7s6MWJko","user":{"login":"ganluo960214","id":8499204,"node_id":"MDQ6VXNlcjg0OTkyMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/8499204?v=4","gravatar_id":"","url":"https://api.github.com/users/ganluo960214","html_url":"https://github.com/ganluo960214","followers_url":"https://api.github.com/users/ganluo960214/followers","following_url":"https://api.github.com/users/ganluo960214/following{/other_user}","gists_url":"https://api.github.com/users/ganluo960214/gists{/gist_id}","starred_url":"https://api.github.com/users/ganluo960214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ganluo960214/subscriptions","organizations_url":"https://api.github.com/users/ganluo960214/orgs","repos_url":"https://api.github.com/users/ganluo960214/repos","events_url":"https://api.github.com/users/ganluo960214/events{/privacy}","received_events_url":"https://api.github.com/users/ganluo960214/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-09-17T06:12:49Z","updated_at":"2024-09-17T06:13:29Z","body":"and if init Granted permisson, it will execute.\r\n```kotlin\r\nval context = LocalPlatformContext.current\r\n  val imagePickerLauncher = rememberFilePickerLauncher(\r\n    type = FilePickerFileType.Image,\r\n    selectionMode = FilePickerSelectionMode.Multiple,\r\n    onResult = { files ->\r\n      scope.launch {\r\n        files.firstOrNull()?.readByteArray(context)\r\n      }\r\n    }\r\n  )\r\n  val videoPickerLauncher = rememberFilePickerLauncher(\r\n    type = FilePickerFileType.Video,\r\n    selectionMode = FilePickerSelectionMode.Single,\r\n    onResult = { files ->\r\n      scope.launch {\r\n        files.firstOrNull()?.readByteArray(context)\r\n      }\r\n    }\r\n  )\r\n\r\n  val onPermissionResult:(\r\n    permissionState:PermissionState,\r\n    success: ()->Unit\r\n  )->Unit = { permissionState, success ->\r\n    if (permissionState.status.isGranted) {\r\n      success()\r\n      closeAfterHide{}\r\n    } else {\r\n      if (permissionState.status.shouldShowRationale){\r\n        permissionState.openAppSettings()\r\n      }\r\n    }\r\n  }\r\n  // 相机权限\r\n  val cameraPermission = rememberPermissionState(\r\n    permission = Permission.Camera,\r\n  )\r\n  LaunchedEffect(cameraPermission.status){\r\n    onPermissionResult(cameraPermission){\r\n      println(\"打开相机\")\r\n    }\r\n  }\r\n  // 相册图片权限\r\n  val galleryImagePermission = rememberPermissionState(\r\n    permission = Permission.Gallery,\r\n  )\r\n  LaunchedEffect(galleryImagePermission.status){\r\n    onPermissionResult(galleryImagePermission){\r\n      imagePickerLauncher.launch()\r\n    }\r\n  }\r\n  // 相册视频权限\r\n  val galleryVideoPermission = rememberPermissionState(\r\n    permission = Permission.Gallery,\r\n  )\r\n  LaunchedEffect(galleryVideoPermission.status){\r\n    println(\"1111111111111111111\")\r\n    onPermissionResult(galleryVideoPermission){\r\n      videoPickerLauncher.launch()\r\n    }\r\n  }\r\n\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/2354616616/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"ganluo960214","id":8499204,"node_id":"MDQ6VXNlcjg0OTkyMDQ=","avatar_url":"https://avatars.githubusercontent.com/u/8499204?v=4","gravatar_id":"","url":"https://api.github.com/users/ganluo960214","html_url":"https://github.com/ganluo960214","followers_url":"https://api.github.com/users/ganluo960214/followers","following_url":"https://api.github.com/users/ganluo960214/following{/other_user}","gists_url":"https://api.github.com/users/ganluo960214/gists{/gist_id}","starred_url":"https://api.github.com/users/ganluo960214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ganluo960214/subscriptions","organizations_url":"https://api.github.com/users/ganluo960214/orgs","repos_url":"https://api.github.com/users/ganluo960214/repos","events_url":"https://api.github.com/users/ganluo960214/events{/privacy}","received_events_url":"https://api.github.com/users/ganluo960214/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/comments/2354814872","html_url":"https://github.com/MohamedRejeb/Calf/pull/179#issuecomment-2354814872","issue_url":"https://api.github.com/repos/MohamedRejeb/Calf/issues/179","id":2354814872,"node_id":"IC_kwDOKDql7s6MW5-Y","user":{"login":"MohamedRejeb","id":41842296,"node_id":"MDQ6VXNlcjQxODQyMjk2","avatar_url":"https://avatars.g